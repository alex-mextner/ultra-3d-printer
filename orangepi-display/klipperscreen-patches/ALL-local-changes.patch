+        # consistent with every other panel beats a black ring around a
+        # correctly-colored card.
+        dialog.get_style_context().add_class("app_dialog_content")
 
         content_area = dialog.get_content_area()
-        content_area.set_margin_start(10)
-        content_area.set_margin_end(5)
-        content_area.set_margin_top(5)
+        # 2026-07-31 black-background fix, dialog follow-up, part 3: these
+        # were set_margin_start(10)/end(5)/top(5)/bottom(0). GTK margins are
+        # empty space OUTSIDE a widget's own painted rectangle -- they come
+        # out of the PARENT's territory, so content_area's background paint
+        # (added below) never reached them, leaving an unpainted ring
+        # exactly this size around the card no matter what CSS class/color
+        # was tried on content_area or on `dialog` itself (confirmed by
+        # pixel-sampling three separate live screenshots, one per attempted
+        # fix). Zeroed out; the equivalent spacing is now CSS padding on
+        # styles/base.css's `.app_dialog_content` instead, which IS inside
+        # the painted rectangle.
+        content_area.set_margin_start(0)
+        content_area.set_margin_end(0)
+        content_area.set_margin_top(0)
         content_area.set_margin_bottom(0)
         content_area.add(content)
+        # 2026-07-31 black-background fix, dialog follow-up, part 2 of 2 --
+        # see dialog.get_style_context().add_class() above for the full
+        # writeup (user report, live screenshot of the "Save configuration?"
+        # confirm dialog rendering solid black). content_area is the widget
+        # that actually spans the dialog's visible content area (same idiom
+        # as main_grid inside screen.py's overlay); the class on `dialog`
+        # above covers the '.dialog''s `margin: 1em` ring around it. Both
+        # share styles/base.css's shared background-color rule so this fixes
+        # every KlippyGtk.Dialog() caller (Save Config, PID Calibrate
+        # confirm, every _confirm_send_action) without touching either
+        # theme file.
+        content_area.get_style_context().add_class("app_dialog_content")
 
         dialog.show_all()
+        # 2026-08-01: start on the harmless button, not the destructive one --
+        # see dialog_dismiss_button() above for the enumeration of callers and
+        # why CANCEL is the safe key. Done AFTER show_all() on purpose: GTK
+        # seeds a window's focus when it is mapped, so anything set before
