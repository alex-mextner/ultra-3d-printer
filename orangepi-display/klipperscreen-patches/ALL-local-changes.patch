+    def on_draw_bar(self, da, ctx):
+        # Theme-aware track. The old fixed rgb(0.13,0.13,0.13) was a black slab
+        # across the light theme, which this machine runs for most of the day
+        # (auto_dark_theme flips every 5 minutes off sunrise/sunset). Taking the
+        # colour from the widget's own style context means the track follows
+        # whichever theme is up, with no theme lookup table to keep in sync.
+        w = da.get_allocated_width()
+        h = da.get_allocated_height()
+        if w < 1 or h < 1:
+            return
+        fg = da.get_style_context().get_color(Gtk.StateFlags.NORMAL)
+        radius = h / 2
+        ctx.set_source_rgba(fg.red, fg.green, fg.blue, 0.18)
+        self._rounded_rect(ctx, 0, 0, w, h, radius)
+        ctx.fill()
+        filled = w * min(max(self.progress, 0), 1)
+        if filled > 0:
+            ctx.set_source_rgb(*self._state_rgb())
+            # max(filled, h): below one bar-height a rounded rectangle degenerates
+            # into a shape narrower than its own corners and disappears, so a
+            # just-started print would show nothing at all.
+            self._rounded_rect(ctx, 0, 0, max(filled, h), h, radius)
+            ctx.fill()
+
+    @staticmethod
+    def _rounded_rect(ctx, x, y, width, height, radius):
+        radius = min(radius, width / 2, height / 2)
+        ctx.new_sub_path()
+        ctx.arc(x + width - radius, y + radius, radius, -pi / 2, 0)
+        ctx.arc(x + width - radius, y + height - radius, radius, 0, pi / 2)
+        ctx.arc(x + radius, y + height - radius, radius, pi / 2, pi)
+        ctx.arc(x + radius, y + radius, radius, pi, 3 * pi / 2)
+        ctx.close_path()
+
+    @staticmethod
+    def format_time_short(seconds):
+        # screen_panel.format_time() spells the units out ("14 minutes"), which
+        # is why the elapsed/left buttons on the detailed page were rendering
+        # as "7 mi..." and "14 minut..." in a ~116px cell (seen in the live
+        # 2026-08-17 screenshots). These readouts are glanced at, not read, so
+        # this panel uses a compact form everywhere a time has to share a row.
+        if seconds is None or seconds < 1:
+            return "-"
+        seconds = int(seconds)
+        days, seconds = divmod(seconds, 86400)
+        hours, seconds = divmod(seconds, 3600)
+        minutes, seconds = divmod(seconds, 60)
+        if days:
+            return f"{days}d {hours}h"
+        if hours:
+            return f"{hours}h {minutes:02d}m"
+        if minutes:
+            return f"{minutes}m"
+        return f"{seconds}s"
+
+    def update_minimal_layer(self):
+        # print_stats.info.current_layer only exists if the slicer emits
+        # SET_PRINT_STATS_INFO -- checked on this machine's own files
+        # (OrcaSlicer 2.4.2, 2026-08-17): it does NOT, so upstream's layer
+        # readout is permanently "-" here. Moonraker's metadata does carry
+        # layer_count/layer_height/first_layer_height, so derive the current
+        # layer from Z the same way Mainsail does when the slicer is silent.
+        total = self.labels["total_layers"].get_text()
+        current = self.labels["layer"].get_text()
+        if current not in ("-", "") and total not in ("-", ""):
+            self._set_layer_text(current.replace(" ", ""))
+            return
+        layer_count = self.file_metadata.get("layer_count")
+        layer_height = self.file_metadata.get("layer_height")
+        first = self.file_metadata.get("first_layer_height", layer_height)
+        if not layer_count or not layer_height:
+            self._set_layer_text("-")
+            return
+        if self.state == "complete":
+            # Reported: "L 0/150" on a finished job looks wrong, and it is. The
+            # fallback below derives the layer from the CURRENT Z, and a
+            # finished print has already lifted/parked the head -- or, in the
+            # UI-only test states, never moved it at all -- so Z says nothing
+            # about how far the job got. The job completing is the better
+            # source: every layer was printed.
+            self._set_layer_text(f"{layer_count}/{layer_count}")
+            return
+        derived = int((self.pos_z - float(first)) / float(layer_height)) + 1
+        derived = min(max(derived, 0), int(layer_count))
+        self._set_layer_text(f"{derived}/{layer_count}")
+
+    def update_minimal_temps(self):
+        # One caption-sized line in the bottom band, both readings in it. On
+        # the minimal page temperatures are confirmation ("yes, it is hot"),
+        # not the headline, so they get the smallest step of the scale and
+        # share a line with the percentage and the layer counter.
+        parts = []
+        extruder = self._printer.get_stat("toolhead", "extruder") or "extruder"
+        for dev in (extruder, "heater_bed"):
+            if dev in self.labels and isinstance(self.labels[dev], Gtk.Label):
+                text = self.labels[dev].get_text()
+                if text and text != "-":
+                    parts.append(text)
+        if "m_temps" in self.labels:
+            self.labels["m_temps"].set_label("  ".join(parts))
+
+    def _set_layer_text(self, value):
+        # Bottom band of the minimal page, sharing one caption-sized line with
+        # the percentage and the temperatures. "L" and not "Layer": the strip
+        # has ~150px before the action buttons start, and the number is the
+        # part that carries information.
+        self.labels["m_layer"].set_label("" if value in ("-", "") else f"L {value}")
