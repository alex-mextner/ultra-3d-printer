+    def dialog_key_press(self, dialog, event):
+        """Let BackSpace dismiss a dialog, the way it leaves every panel.
+
+        2026-08-01, measured on the "Save configuration?" confirm. A
+        KlippyGtk.Dialog() is a separate modal toplevel, so its key events
+        never reach screen.py's _key_press_event: pressing BackSpace on the
+        open dialog produced no trace line at all (and screen.py traces
+        every key unconditionally), and the dialog stayed. Arrows do move
+        focus -- GTK's own focus chain handles that inside the dialog
+        window, also without a trace -- and Enter does activate, so the
+        dialog was escapable only by arrowing onto Cancel and pressing
+        Enter. Escape is bound natively by GtkDialog but is unreachable on
+        this machine: nav-buttons-remap.py cannot emit KEY_ESC at all.
+
+        Two things made this worth fixing rather than just documenting.
+        The confirm dialog opens with focus on the DESTRUCTIVE button
+        (Save, which writes printer.cfg on the printer and reboots Klipper,
+        bypassing the repo-is-source-of-truth workflow), so the universal
+        "get me out" key doing nothing is precisely the wrong default. And
+        a Dialog() built with no buttons at all closes only on "click
+        anywhere" -- a mouse event this machine cannot produce -- so for
+        that shape there was no five-button exit whatsoever.
+
+        CANCEL rather than remove_dialog(): every response callback in this
+        codebase either acts only on Gtk.ResponseType.OK, or tests CANCEL
+        explicitly (gcodes.py, job_status.py, network.py), so CANCEL is the
+        one value that is safe everywhere AND still runs each caller's own
+        teardown instead of pulling the dialog out from under it. One
+        deliberate exception: base_panel.py's in-progress update dialog
+        ignores any non-OK response, so BackSpace leaves it open -- correct,
+        an update in flight must not be dismissable.
+
+        Returns False for every other key so arrows and Enter keep working.
+        """
+        if Gdk.keyval_name(event.keyval) != "BackSpace":
+            return False
+        logging.info("Dialog dismissed with BackSpace")
+        dialog.response(Gtk.ResponseType.CANCEL)
+        return True
+
+    @staticmethod
+    def dialog_dismiss_button(dialog, buttons):
+        """The button a reflexive Enter is allowed to hit: Cancel, if there is one.
+
+        2026-08-01. A KlippyGtk.Dialog() has no content-area focus of its
+        own in the confirm shape (the content is a Gtk.Label), so GTK seeds
+        focus on the FIRST action-area button -- which in this codebase is
+        the destructive one almost everywhere it matters:
+
+            screen.py confirm_save          Save (runs SAVE_CONFIG, which
+                                            rewrites printer.cfg ON THE
+                                            PRINTER, around the repo, and
+                                            reboots Klipper)
+            panels/gcodes.py confirm_print  Delete (deletes the gcode file)
+            panels/shutdown.py              Host / Printer power off
+            panels/updater.py               Update / Recover Hard
+            panels/network.py               Forget
+            panels/job_status.py            Restart Print / Cancel Print
+
+        On a five-button machine with no touch and no mouse, Enter is the
+        one key a user presses without aiming, and BackSpace (this file's
+        dialog_key_press) is the only other way out. Seeding focus on the
+        no-op button instead makes the unaimed press harmless everywhere
+        at once, and costs exactly one extra arrow press for the deliberate
+        one.
+
+        Deliberately keyed on Gtk.ResponseType.CANCEL rather than on
+        "position in the list" or a per-caller parameter:
+
+        * CANCEL is this codebase's one marker for "the button that does
+          nothing": every response callback either acts only on OK/APPLY/
+          ACCEPT/REJECT, or tests CANCEL explicitly and returns. Focusing it
+          therefore cannot invoke behaviour anywhere -- focus is not
+          activation, and the callbacks were already grepped for this same
+          reason when BackSpace was wired to CANCEL.
+        * Dialogs WITHOUT a CANCEL button are left exactly as they were:
+          the error modal (Close), base_panel.py's update dialog (Finish),
+          both no-button image/graph dialogs, and every klipper-driven
+          prompt in widgets/prompts.py, whose responses are positive ints
+          from its own counter (self.id starts at 1) and so can never
+          collide with the negative Gtk.ResponseType values.
+        * Nothing in this codebase calls set_default_response(),
+          set_default() or set_activates_default() (grepped 2026-08-01), so
+          focus is genuinely what decides where Enter lands; there is no
+          default widget quietly overriding it.
+        """
+        if not buttons:
+            return None
+        if not any(button.get("response") == Gtk.ResponseType.CANCEL for button in buttons):
+            return None
+        return dialog.get_widget_for_response(Gtk.ResponseType.CANCEL)
+
     def Dialog(self, title, buttons, content, callback=None, *args):
