+    def _trace_key(self, keyval_name, focus_before, handled):
+        # One line per key press, see the comment at the top of
+        # _key_press_event. A method rather than an inline logging.info()
+        # since 2026-08-02, so the branches that return early (the smoke
+        # alarm one) produce the exact same line as the common path instead
+        # of a differently-shaped one that greps would miss.
+        logging.info(
+            f"Key {keyval_name}: focus {focus_before} -> "
+            f"{self._describe_focus(self.get_focus())} | handled={handled}"
+            f" via {self._key_trace_branch} | panel="
+            f"{self._cur_panels[-1] if self._cur_panels else None}"
+        )
+
+    def _can_take_focus(self, widget):
+        # True only if Gtk.Window.set_focus(widget) would really move focus
+        # there. Mirrors gtk_widget_grab_focus()'s own preconditions: it is
+        # a SILENT no-op on an insensitive or non-focusable widget, and on
+        # one whose toplevel is no longer this window (unparented with a
+        # Python reference still holding it alive). Checking these up front
+        # is what lets the caller avoid claiming a key it did not use.
+        if widget is None:
+            return False
+        try:
+            return bool(
+                widget.get_mapped()
+                and widget.is_sensitive()
+                and widget.get_can_focus()
+                and widget.get_toplevel() is self
+            )
+        except Exception:
+            return False
+
+    def _focus_into_current_panel(self, keyval_name="Down"):
+        # Put focus somewhere sensible inside the visible panel body, and
+        # report whether it landed. Used when there is no focus and nothing
+        # valid to restore -- most importantly right after the on-screen
+        # Back button was activated, which makes that very button
+        # insensitive and so leaves focus at None with the user staring at
+        # a fresh panel. Aiming explicitly at base_panel.content keeps the
+        # press inside the panel actually on screen, instead of GTK's
+        # from-nothing fallback which sends Down to the sidebar bell.
+        content = getattr(self.base_panel, "content", None)
+        if content is None:
+            return False
+        pressed = {
+            "Up": Gtk.DirectionType.UP,
+            "Down": Gtk.DirectionType.DOWN,
+            "Left": Gtk.DirectionType.LEFT,
+            "Right": Gtk.DirectionType.RIGHT,
+        }.get(keyval_name, Gtk.DirectionType.DOWN)
+        # TAB_FORWARD as the fallback: a purely directional child_focus()
+        # can decline to enter a container at all depending on geometry,
+        # whereas tab order always has a first focusable element if one
+        # exists anywhere in the panel.
+        for direction in (pressed, Gtk.DirectionType.TAB_FORWARD):
+            try:
+                if content.child_focus(direction) and self.get_focus() is not None:
+                    return True
+            except Exception:
+                logging.exception("Focusing into the current panel failed")
+                return False
+        return False
+
+    def _describe_focus(self, widget):
+        # Short, log-safe identity of a focus target: type, its label, and
+        # the four properties that decide whether it can actually TAKE
+        # focus. mapped/sensitive/can-focus matter because
+        # gtk_widget_grab_focus() is a silent no-op when any of them is
+        # false -- so a set_focus() call can appear to succeed while focus
+        # stays exactly where it was. "detached" (toplevel is not this
+        # window) catches a widget that has been unparented out of the
+        # tree. Never raises: this only ever runs to build a log line, and
+        # a broken log line must not break input handling.
+        if widget is None:
+            return "None"
+        try:
+            name = type(widget).__name__
+            label = ""
+            if isinstance(widget, Gtk.Button):
+                label = widget.get_label() or ""
+            if not label:
+                try:
+                    label = widget.get_tooltip_text() or ""
+                except Exception:
+                    label = ""
+            label = str(label).strip().replace("\n", " ")[:24]
+            flags = ""
+            try:
+                if not widget.get_mapped():
+                    flags += " UNMAPPED"
+                if not widget.is_sensitive():
+                    flags += " INSENSITIVE"
+                if not widget.get_can_focus():
+                    flags += " NO-CAN-FOCUS"
+                if widget.get_toplevel() is not self:
+                    flags += " DETACHED"
+            except Exception:
+                pass
+            return f"{name}{'(' + label + ')' if label else ''}{flags}"
+        except Exception as exc:
+            return f"<undescribable {exc}>"
+
+    def _dpad_scrollables(self, widget, found, depth=0):
+        # Collect the currently-mapped Gtk.ScrolledWindows of the visible
+        # panel body. Mapped-only matters because KlipperScreen keeps
+        # non-visible panels instantiated in self.panels.
+        if widget is None or depth > 16:
+            return
+        try:
+            if not widget.get_mapped():
+                return
+        except Exception:
+            return
+        if isinstance(widget, Gtk.ScrolledWindow):
+            found.append(widget)
+        if isinstance(widget, Gtk.Container):
+            for child in widget.get_children():
+                self._dpad_scrollables(child, found, depth + 1)
+
+    def _escape_range_focus(self, keyval_name):
+        """Let Left/Right leave a focused slider. True = key consumed.
+
+        2026-08-01 panel sweep. Gtk.Scale (a Gtk.Range) binds Left/Right to
+        "change the value", and always consumes them -- so once focus is on
+        a slider it can never move sideways, and every control sitting
+        beside the slider becomes unreachable on a 5-button pad. Measured
+        on panels/fan.py, where the row is literally
+        Box[stop_btn, scale, max_btn]: focus enters the scale and the trace
+        shows six presses in a row that never move it --
+
+            Key Right: focus Scale -> Scale | handled=False via gtk-default
+            Key Left:  focus Scale -> Scale | handled=False via gtk-default
+
+        -- so Stop and Max, the only two widgets on that panel that
+        actually DO anything, could not be reached at all. Up/Down do not
+        rescue it either: both buttons are in the same horizontal box, so
+        there is nothing above or below to move to, and _dpad_scroll just
+        nudged the viewport by 29px instead.
+
+        Nothing is lost by taking these keys away from the slider here,
+        because an UNCAPTURED slider is not meant to be edited: editing is
+        an explicit mode entered with Enter (see _capture_range below), and
+        while captured these keys never reach this function at all --
+        _key_press_event consumes them first. So Left/Right on a slider you
+        are merely passing through does the only useful thing it can:
+        reach the buttons beside it.
+
+        2026-08-01, second pass: this docstring used to claim sliders were
+        permanently read-only indicators because every Gtk.Scale in the
+        codebase commits on "button-release-event" only. That was measured
+        and true at the time, and is no longer -- _release_range() now
+        raises exactly that event from the keyboard. The commit path is
+        unchanged for mouse/touch.
+
+        Falls through (returns False) when there is nothing to move to, so
+        on a panel where the slider really is the only control the old
+        behaviour is unchanged.
+        """
+        focus = self.get_focus()
+        if not isinstance(focus, Gtk.Range):
+            return False
+        content = getattr(self.base_panel, "content", None)
+        if content is None:
+            return False
+        direction = (
+            Gtk.DirectionType.LEFT if keyval_name == "Left" else Gtk.DirectionType.RIGHT
+        )
+        try:
+            if content.child_focus(direction):
+                moved = self.get_focus()
+                if moved is not None and moved is not focus:
+                    self._key_trace_branch = "escape-range-focus"
+                    return True
+        except Exception:
+            logging.exception("Escaping slider focus failed")
+        return False
+
+    def _capture_range(self, widget):
+        """Enter D-pad editing mode on a focused slider.
+
+        2026-08-01. Until now a Gtk.Scale on this machine was decoration: a
+        five-button D-pad could neither change its value nor transmit one.
+        Both halves were measured live on panels/fan.py, and BOTH were
+        broken -- the second one is the half the queue item did not know
+        about:
+
+          Key Right: focus Scale -> Button(Max) | via escape-range-focus
+          Key Up:    focus Scale -> Scale | via gtk-default(scrollable
+                     already at top, value=0/29)
+          Key Down:  focus Scale -> Scale | via dpad-scroll/adjustment
+                     0->29 of 29
+
+        Right/Left never reach the slider (they are how focus escapes it,
+        and they must stay that way -- Stop and Max sit either side of the
+        fan slider and are otherwise unreachable). Up DOES reach the
+        slider, but GTK maps STEP_UP on a range to *decrease*, so from 0 it
+        just clamped. Down was eaten by _dpad_scroll before the slider saw
+        it. Net result: the fan slider could not be raised by even one step,
+        so "commit the value on a keyboard event" alone would have fixed
+        nothing.
+
+        The fix is an explicit editing mode rather than a global re-mapping
+        of the arrows, for two reasons. It keeps every panel's navigation
+        exactly as the 2026-08-01 panel sweep verified it (re-purposing
+        Up/Down for all ranges would have changed navigation on Limits and
+        Pressure Advance, the panels that sweep certified), and it gives
+        the commit a natural moment: one command when the user applies,
+        instead of one per arrow press. Enter was free -- Gtk.Range binds
+        no activate action and nothing else here looked at Return.
+
+        Contract: Enter captures, arrows adjust, Enter applies, Back/Escape
+        cancels and restores the entry value. The slider turns amber
+        (.slider_captured in base.css) for as long as it is captured.
+        """
+        self._captured_range = widget
+        self._captured_range_entry_value = widget.get_value()
+        try:
+            widget.get_style_context().add_class("slider_captured")
+        except Exception:
+            logging.exception("Could not mark slider as captured")
+        logging.info(
+            f"Slider captured at {self._captured_range_entry_value:g}, "
+            f"d-pad step {self._range_step(widget):g}"
+        )
+
+    def range_captured(self, widget):
+        """Is this exact slider currently held in D-pad editing mode?
+
+        The keyboard counterpart of Gtk.Widget.has_grab(), and the reason it
+        has to exist: has_grab() answers only for a POINTER grab, i.e. "a
+        mouse button is down on this widget". Every panel that owns a slider
+        guards its status-update path with has_grab() so that an incoming
+        notify_status_update cannot yank the handle out from under a finger
+        -- but on this machine there is no finger, the edit is a keyboard
+        capture (_capture_range), and that guard saw nothing.
+
+        Reproduced live 2026-08-01 on Limits before this existed: slider
+        captured at 175, arrowed to 129, then SET_VELOCITY_LIMIT VELOCITY=175
+        sent from Moonraker -- limits.update_option() ran, set_value() landed
+        on the captured widget, and the screen showed 175 with the capture
+        still active and no indication the edit had been discarded.
+
+        Panels call ScreenPanel.range_is_busy(), which ORs this with
+        has_grab(); this method is what makes the private capture state
+        askable from outside.
+        """
+        return self._captured_range is not None and self._captured_range is widget
+
+    def _forget_range_capture(self):
+        # Drop the capture state without sending or restoring anything.
+        widget = self._captured_range
+        self._captured_range = None
+        self._captured_range_entry_value = None
+        if widget is not None:
+            try:
+                widget.get_style_context().remove_class("slider_captured")
+            except Exception:
+                pass
+        return widget
+
+    def _release_range(self, commit):
+        widget = self._captured_range
+        entry_value = self._captured_range_entry_value
+        self._forget_range_capture()
+        if widget is None:
+            return
+        try:
+            value = widget.get_value()
+        except Exception:
+            logging.exception("Releasing slider capture failed")
+            return
+        if not commit:
+            if value != entry_value:
+                widget.set_value(entry_value)
+            logging.info(f"Slider capture cancelled: {value:g} restored to {entry_value:g}")
+            return
+        if value == entry_value:
+            # Nothing to say. Enter-then-Enter with no arrows in between is
+            # a no-op, not a redundant gcode_script.
+            logging.info(f"Slider capture applied unchanged ({value:g}); nothing sent")
+            return
+        logging.info(f"Slider capture applied: {entry_value:g} -> {value:g}")
+        self._commit_range(widget)
+
+    def _commit_range(self, widget):
+        """Send a captured slider's value the way a mouse release would.
+
+        Every Gtk.Scale in this codebase -- fan, limits, led, pins,
+        retraction, pressure_advance, input_shaper, plus the generic
+        "scale" setting row in ks_includes/screen_panel.py -- wires its
+        transmit handler to "button-release-event" and to nothing else.
+        Rather than add a second signal at all eight construction sites
+        (and keep them in sync forever), raise the event those handlers
+        already listen for. One place, and mouse/touch behaviour is
+        untouched by construction.
+
+        Verified in isolation on this device's GTK 3.24.49 before wiring it
+        up, because a synthetic event with no GdkWindow is the obvious way
+        for this to explode: emitting "button-release-event" with
+        Gdk.Event.new(BUTTON_RELEASE) on a Gtk.Scale calls the connected
+        handler, hands it a real EventButton, and returns False. It is safe
+        here specifically because GTK 3.24's GtkRange has no
+        button_release_event class handler (it uses gesture controllers,
+        which a direct g_signal_emit does not run), and because none of the
+        eight handlers reads the event argument -- all of them take it and
+        immediately call widget.get_value() or read their adjustment.
+        """
+        try:
+            event = Gdk.Event.new(Gdk.EventType.BUTTON_RELEASE)
+            widget.emit("button-release-event", event)
+        except Exception:
+            logging.exception("Slider commit failed")
+
+    def _range_step(self, widget):
+        """How far one arrow press moves a captured slider.
+
+        The adjustment's own step_increment is unusable on a D-pad: it is 1
+        on Limits, where max_accel's range is ~1..4500, i.e. 4500 presses
+        end to end. Measured X autorepeat on this device is 25/s after a
+        660ms delay (xset q), so a step sized to ~100 presses per full
+        range means a held button crosses the whole slider in ~4.6s while a
+        single tap is still a fine-grained nudge. Snapped to a whole number
+        of step_increments so the displayed value keeps the panel's own
+        granularity (0.05 on Pressure Advance, 1 on Fan/Limits), and never
+        smaller than step_increment -- on short ranges (Pressure Advance
+        0..1) the panel's own increment is already the coarser of the two.
+        """
+        adj = widget.get_adjustment()
+        step = adj.get_step_increment() or 1
+        coarse = (adj.get_upper() - adj.get_lower()) / 100.0
+        if coarse > step:
+            step = max(1, round(coarse / step)) * step
+        return step
+
+    def _adjust_captured_range(self, keyval_name):
+        widget = self._captured_range
+        adj = widget.get_adjustment()
+        step = self._range_step(widget)
+        delta = step if keyval_name in ("Up", "Right") else -step
+        before = adj.get_value()
+        value = min(max(before + delta, adj.get_lower()), adj.get_upper())
+        # Round to the precision the panel actually displays, so the value
+        # committed is the value on screen. Measured live on Pressure
+        # Advance 2026-08-01: arrowing back down to the bottom of the range
+        # showed "0.00" but transmitted
+        # "SET_PRESSURE_ADVANCE EXTRUDER=extruder ADVANCE=1.3877787807814457e-17",
+        # because repeated float addition of a 0.05 step does not land on
+        # zero. Harmless there, but "what is sent is not what is shown" is
+        # the exact shape of bug this whole slider fix exists to remove.
+        # Gtk.Scale.get_digits() is the panel's own declared granularity (0
+        # on Fan and Limits, 2 on Pressure Advance, 3 on Smooth time), so
+        # this can never round a slider coarser than it renders. set_value()
+        # re-clamps to the adjustment afterwards, so rounding outward at a
+        # non-round upper bound cannot escape the range.
+        digits = widget.get_digits()
+        if digits >= 0:
+            value = round(value, digits)
+        if value != before:
+            widget.set_value(value)
+        self._key_trace_branch = (
+            f"range-capture/adjust {before:g}->{widget.get_value():g} step={step:g}"
+        )
+        # Always claim the key, including at the ends of the range: while a
+        # slider is captured the arrows belong to it and must not leak to
+        # _escape_range_focus or _dpad_scroll, or hitting the maximum would
+        # silently throw the user out of the edit.
+        return True
+
+    def _scrollable_ancestor(self, widget, candidates):
+        # Which of the collected scrolled windows actually contains this
+        # widget, so a reveal scrolls the viewport the widget is really in.
+        # Returns None when the newly focused widget sits outside every
+        # list -- e.g. the console's command entry, which is a sibling of
+        # the log, not a row inside it. Scrolling `target` in that case
+        # would move a viewport the user is not even in.
+        for sw in candidates:
+            try:
+                if widget is sw or widget.is_ancestor(sw):
+                    return sw
+            except Exception:
+                continue
+        return None
+
+    def _dpad_reveal_focus(self, sw):
+        # Keep the newly focused row on screen. GTK3's own scroll-to-focus
+        # is not dependable across the container nestings the panels use
+        # (Button>AutoGrid>Viewport>CustomScrolledWindow and friends), so
+        # compute it explicitly from the widget's position relative to the
+        # scrolled window's visible area.
+        widget = self.get_focus()
+        if widget is None:
+            return
+        adj = sw.get_vadjustment()
+        if adj is None:
+            return
+        coords = widget.translate_coordinates(sw, 0, 0)
+        if coords is None:
+            return
+        y = coords[1]
+        height = widget.get_allocated_height()
+        page = adj.get_page_size()
+        margin = 4
+        value = adj.get_value()
+        if y < margin:
+            value += y - margin
+        elif y + height > page - margin:
+            value += (y + height) - (page - margin)
+        else:
+            return  # already fully visible
+        bottom = max(adj.get_lower(), adj.get_upper() - page)
+        adj.set_value(min(max(value, adj.get_lower()), bottom))
+
+    def _dpad_scroll(self, down):
+        """Up/Down list scrolling for a 5-button D-pad. True = key consumed.
+
+        Only ever acts on a panel that genuinely overflows vertically; on
+        anything that already fits it returns False immediately and GTK's
+        stock focus handling runs exactly as it did before.
+        """
+        if self.keyboard is not None:
+            return False  # an on-screen keyboard is up; arrows belong to it
+        try:
+            candidates = []
+            self._dpad_scrollables(self.base_panel.content, candidates)
+            focus = self.get_focus()
+            target = None
+            for sw in candidates:
+                adj = sw.get_vadjustment()
+                if adj is None or adj.get_upper() - adj.get_page_size() <= 1:
+                    continue  # this one has nothing to scroll
+                if target is None:
+                    target = sw
+                if focus is not None and focus.is_ancestor(sw):
+                    target = sw  # prefer the list the user is already in
+                    break
+            if target is None:
+                self._key_trace_branch = "gtk-default(no overflowing scrollable)"
+                return False
+            direction = Gtk.DirectionType.DOWN if down else Gtk.DirectionType.UP
+            # Move the focus first -- and search the WHOLE visible panel
+            # body, not just the overflowing scrollable.
+            #
+            # 2026-08-01, console focus trap (user: "открыл сейчас консоль и
+            # курсор перестал двигаться, esc работает"). Searching only
+            # inside `target` had two failure modes which together bricked
+            # navigation on panels/console.py:
+            #   * it STEERS focus into the scrollable. The trace caught the
+            #     exact moment -- "Down: focus Button(Clear) -> TextView |
+            #     handled=True via dpad-scroll/child_focus" -- even though
+            #     the widget the user was heading for (the command entry)
+            #     is a SIBLING of the list, not a child of it. So this
+            #     function was not merely eating Up/Down, it was what
+            #     created the trap.
+            #   * once focus was inside, child_focus() had nowhere further
+            #     to go, so every later Up/Down fell through to scrolling
+            #     the viewport and still returned True. Focus could get IN
+            #     but never OUT -- and Left/Right meanwhile went to GTK,
+            #     where the focused widget's own arrow bindings ate them
+            #     (GtkTextView moves its caret, GtkScrolledWindow scrolls).
+            #     On a machine whose only other keys are Enter and Back
+            #     that is a dead panel.
+            # base_panel.content is the whole panel body, so focus can now
+            # cross between a list and its siblings. The "no overflowing
+            # scrollable" early return above is untouched, so this function
+            # stays completely inert on panels that already fit and their
+            # stock GTK arrow navigation is unaffected.
+            content = self.base_panel.content
+            if content is not None and content.child_focus(direction):
+                moved = self.get_focus()
+                if moved is not None and moved is not focus:
+                    reveal = self._scrollable_ancestor(moved, candidates)
+                    if reveal is not None:
+                        self._dpad_reveal_focus(reveal)
+                    self._key_trace_branch = "dpad-scroll/child_focus"
+                    return True
+            # Focus cannot move any further in this direction (or there is
+            # nothing focusable at all) -- move the viewport itself so
+            # long unfocusable content stays readable.
+            adj = target.get_vadjustment()
+            step = max(adj.get_page_size() * 0.8, 40)
+            bottom = max(adj.get_lower(), adj.get_upper() - adj.get_page_size())
+            value = adj.get_value() + (step if down else -step)
+            value = min(max(value, adj.get_lower()), bottom)
+            if abs(value - adj.get_value()) < 1:
+                self._key_trace_branch = (
+                    f"gtk-default(scrollable already at {'bottom' if down else 'top'}, "
+                    f"value={adj.get_value():.0f}/{bottom:.0f})"
+                )
+                return False  # already at that end, let GTK have the key
+            self._key_trace_branch = (
+                f"dpad-scroll/adjustment {adj.get_value():.0f}->{value:.0f} of {bottom:.0f}"
+            )
+            adj.set_value(value)
+            return True
+        except Exception:
+            logging.exception("D-pad scroll failed")
+            return False
+
+    def _on_set_focus(self, window, widget):
+        # Track the most recent non-None focus target continuously (not
+        # just at clear-timeout time) so it always reflects wherever the
+        # user last navigated, for the resume-from-idle restore above.
+        # Skip while the screensaver is up: ScreenSaver.show() calls
+        # grab_focus() on its own throwaway close-button, which would
+        # otherwise overwrite _last_focus_widget with a widget that gets
+        # unparented again on wake -- leaving the resume-from-idle restore
+        # pointing at a dead widget after every blank/wake cycle.
+        if self._captured_range is not None and widget is not self._captured_range:
+            # Focus left a captured slider without going through Enter or
+            # Back: panel teardown, the screensaver grabbing focus, a
+            # rebuilt widget tree. Abandon the edit and send NOTHING -- a
+            # gcode command must never be a side effect of a panel going
+            # away. Cannot be reached from ordinary D-pad use, because
+            # every key that could move focus is consumed while captured.
+            logging.info("Slider capture abandoned: focus moved off the slider")
+            self._forget_range_capture()
+        if widget is not None and not self.screensaver.is_showing:
+            self._last_focus_widget = widget
+
+    def _reset_focus_clear_timeout(self):
+        # This is a 5-button D-pad, not a touchscreen: focus only exists to
+        # show where a button/arrow press will land. Leaving the highlight
+        # on indefinitely after the last press makes an otherwise idle,
+        # at-rest screen look like something is stuck/selected, so clear it
+        # after a few seconds of no further input instead.
+        if self._focus_clear_timeout_id is not None:
+            GLib.source_remove(self._focus_clear_timeout_id)
+        self._focus_clear_timeout_id = GLib.timeout_add_seconds(10, self._clear_focus_on_timeout)
+
+    def _clear_focus_on_timeout(self):
+        if self._captured_range is not None:
+            # A slider is being edited with the D-pad. Dropping focus here
+            # would take the highlight away mid-edit and, through
+            # _on_set_focus, throw the edit away -- for a user who simply
+            # paused to think. Editing is an explicit, visibly-marked mode
+            # with its own exits (Enter applies, Back cancels), so hold the
+            # highlight and re-arm instead.
+            self._focus_clear_timeout_id = None
+            self._reset_focus_clear_timeout()
+            return False
+        # Traced too (2026-08-01): this is what turns the NEXT arrow press
+        # into a restore-only press (see the resume branch in
+        # _key_press_event), which from the user's side is a key that did
+        # nothing visible -- so the log has to say when it fired.
+        logging.info(f"Focus cleared after idle: was {self._describe_focus(self.get_focus())}")
+        self.set_focus(None)
+        self._focus_clear_timeout_id = None
+        return False
 
