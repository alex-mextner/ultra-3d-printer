+
+    def __init__(self, url, max_size, on_frame, on_status, gate=None,
+                 fps=TARGET_FPS, flip_h=False, flip_v=False, rotation=0):
+        self.url = url
+        self._max_w, self._max_h = max_size
+        self._on_frame = on_frame
+        self._on_status = on_status
+        self._gate = gate
+        self._period = 1.0 / max(1, fps)
+        self._flip_h = flip_h
+        self._flip_v = flip_v
+        self._rotation = ROTATIONS.get(rotation)
+        if rotation and self._rotation is None:
+            logging.info(f"camera: ignoring unsupported rotation {rotation}")
+        # A quarter turn swaps the axes, so decode into the transposed box to
+        # end up filling the real one.
+        if rotation in (90, 270):
+            self._max_w, self._max_h = self._max_h, self._max_w
+        self._stop = threading.Event()
+        self._lock = threading.Lock()
+        self._pending = None
+        self._idle_queued = False
+        self._thread = None
+
+    def start(self):
+        if self._thread is not None:
+            return
+        self._thread = threading.Thread(target=self._run, daemon=True, name="camera-stream")
+        self._thread.start()
