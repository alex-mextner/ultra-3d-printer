+/* 2026-08-02 smoke alarm banner (screen.py, _smoke_alarm_build_banner).
+ * Full-screen red overlay child shown while the siren is sounding.
+ *
+ * Sizes are absolute px on CLASS selectors, not KS_FONT_SIZE and not
+ * element selectors, for one specific reason: every theme's style.css is
+ * concatenated AFTER this file and each of them contains a bare
+ * `* { font-size: 14px }`. A class selector outranks `*` on specificity, so
+ * these survive both themes and the day/night switch between them; anything
+ * relying on inheritance or on source order would silently come out 14px.
+ * Both themes get the same red -- an alarm is not a place for a light and a
+ * dark variant, and the text is white on a deep red in either case.
+ * Colours are literal rather than @error so that a theme redefining @error
+ * cannot dilute them. */
+.smoke_alarm {
+    background-color: #B00000;
+    background-image: none;
+    border: 0;
+    margin: 0;
+    padding: 0.2em;
+}
+
+.smoke_alarm_title {
+    color: #FFFFFF;
+    font-size: 46px;
+    font-weight: bold;
+}
+
+.smoke_alarm_text {
+    color: #FFFFFF;
+    font-size: 18px;
+    font-weight: bold;
+}
+
+.smoke_alarm_hint {
+    color: #FFD5D5;
+    font-size: 13px;
+}
+
 .option_slider_max trough highlight,
 trough progress {
     background-color: @error;
 }
 
+/* 2026-08-01: a slider being edited with the D-pad (Enter captures it, the
+ * arrows then move the value, Enter applies, Back cancels -- see
+ * _capture_range() in screen.py). Without a visible mark the two states are
+ * indistinguishable on a machine with no pointer, and the same four arrows
+ * mean different things in each, which is exactly how a mode becomes a
+ * trap. Colour only, no border/size: this layout has been fought px by px
+ * and a captured slider must not resize. @warning is defined identically in
+ * both bundled themes, so one rule in base.css covers dark and light -- the
+ * same reason black-background-fix.patch and the .heatergraph fix live here
+ * rather than in the theme files. Placed AFTER the .option_slider_max rule
+ * above deliberately: on Limits a slider past its configured maximum is
+ * already painted @error, and capture has to win over that while it lasts. */
+.slider_captured trough highlight,
+.slider_captured trough progress {
+    background-color: @warning;
+}
+
+/* The filled part alone is not enough, and this was caught by a live frame
+ * rather than by reasoning: a slider captured at its minimum has no filled
+ * part at all, so a captured fan slider at 0 -- the single most likely
+ * starting point on this machine -- looked pixel-identical to an
+ * uncaptured one. The handle is present at every value, so colour that
+ * too. background-image must be cleared explicitly: the stock theme paints
+ * the handle with a gradient image, and an image beats a background-color
+ * underneath it. */
+.slider_captured trough slider {
+    background-image: none;
+    background-color: @warning;
+}
+
