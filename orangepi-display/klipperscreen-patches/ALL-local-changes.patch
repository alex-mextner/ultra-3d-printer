+    def _set_value(self, button, text):
+        # Detailed-page readouts are a caption/value pair, not a single label
+        # (see _readout), so set_label() on the button would destroy the
+        # composition. Registered buttons get their value label written; an
+        # unregistered one falls back to the old behaviour rather than silently
+        # dropping the reading, which is the failure mode that is hardest to
+        # notice on a screen nobody is watching.
+        if (label := self.readout_values.get(button)) is not None:
+            label.set_label(text)
+        else:
+            button.set_label(text)
+
+    def _readout(self, key, caption, on_click=None):
+        # One cell of the detailed page's 2x4 grid.
+        #
+        # Why this replaces the icon+label buttons that were here: the user's
+        # verdict on those was "нет приоритета через bold и font size, сетка
+        # плывет, а серые боксы только подчеркивают кривизну", and all three
+        # come from the same construction. An icon+label button is ONE label,
+        # so caption and value cannot have different weights; the label is
+        # left-aligned after an icon, so "215/215°" and "0.0 mm³/s" start at
+        # different x and end at different x, which is what makes a grid of
+        # them look like it is drifting; and .printing-info paints each of them
+        # with a grey box that draws a hard outline around that drift.
+        #
+        # Here: caption on the left at the caption step of the scale, value on
+        # the right at the value step, xalign=1.0 so every number in a column
+        # ends on the SAME vertical edge whatever its width. The grey box is
+        # dropped in CSS (both themes, .printing-info button), so the alignment
+        # is what the eye follows instead of a rectangle.
+        button = Gtk.Button(hexpand=True, vexpand=True)
+        button.set_can_focus(
+            self._screen._config.get_main_config().getboolean("keyboard_navigation", fallback=False)
+        )
+        row = Gtk.Box(spacing=4)
+        cap = Gtk.Label(label=caption, xalign=0.0, ellipsize=Pango.EllipsizeMode.END)
+        cap.get_style_context().add_class("js-caption")
+        val = Gtk.Label(label="-", xalign=1.0, hexpand=True, ellipsize=Pango.EllipsizeMode.END)
+        val.get_style_context().add_class("js-value")
+        row.pack_start(cap, False, False, 0)
+        row.pack_start(val, True, True, 0)
+        button.add(row)
+        if on_click is not None:
+            button.connect("clicked", *on_click)
+        button.connect("clicked", self._screen.screensaver.reset_timeout)
+        button.connect("clicked", self._screen.lock_screen.reset_timeout)
+        self.buttons[key] = button
+        self.readout_values[button] = val
+        return button
+
+    def _action_button(self, key, icon, style, on_click, args=None):
+        # THE button of this panel. Every action lives in one compact
+        # bottom-right icon strip built from this factory, in every state --
+        # see create_buttons for why this particular control and no other.
+        #
+        # No label and no tooltip. No label because «только иконки, без
+        # подписей»; no tooltip because GTK draws one as a dark slab that
+        # covers a third of a 320x240 screen the moment the mouse pointer comes
+        # to rest (caught on a live screenshot, a black rectangle over the Fan
+        # and Left readouts). And no caption-on-focus either, which was tried
+        # and rejected on sight: «нивкоем случае текст на фокус, все будет
+        # прыгать» -- a label that appears and disappears with the focus moves
+        # the layout under the user on every single press.
+        #
+        # no_show_all, because which buttons exist depends on the print state
+        # (show_buttons_for_state) and this panel is show_all()'d from several
+        # places outside itself -- attach_panel, _screen.show_all() after a
+        # tool change, show_buttons_for_state's own call. Any of them would
+        # otherwise put Pause back on a finished job.
+        button = self._gtk.Button(icon, None, style, 0.8)
+        button.set_hexpand(False)
+        button.set_vexpand(False)
+        button.set_valign(Gtk.Align.CENTER)
+        button.get_style_context().add_class("js-action")
+        if args is None:
+            button.connect("clicked", on_click)
+        else:
+            button.connect("clicked", on_click, args)
+        button.set_no_show_all(True)
+        self.buttons[key] = button
+        return button
+
+    def create_minimal_grid(self):
+        # =====================================================================
+        # THE MINIMAL (default) PRINT PAGE -- rev 3, 2026-08-17 evening.
+        #
+        # Asked for, twice, verbatim:
+        #   «и можно ли миниатюру модели на весь дисплей а все поверх рисовать»
+        #   «но не обрезть ее за границы экрана!»
+        # and after rev 2 shipped a 116px thumbnail BESIDE a column of numbers:
+        #   «дисплей так и не показывает миниатюру на весь экран а параметры
+        #    поверх как я просил»
+        #
+        # So: the picture is the page. It is centred on the full width of the
+        # content area, and the readings sit in bands over that same canvas
+        # instead of in a column next to it.
+        #
+        #   +--------------------------------------------------+ 28px band
+        #   | 1h 05m                     OrcaCube_v2_0.2mm...  |
+        #   +--------------------------------------------------+
+        #   |                                                  |
+        #   |                +--------------+                  | image region,
+        #   |                |    model     |                  | 286 x ~148
+        #   |                +--------------+                  |
+        #   |                                                  |
+        #   +--------------------------------------------------+
+        #   | ============================================     | 8px bar
+        #   | 45%  L 42/150  210°/60°        [||] [X] [i]      | ~28px strip
+        #   +--------------------------------------------------+
+        #
+        # WHY BANDS AND NOT FREE-FLOATING TEXT ON THE IMAGE. An image that is
+        # scaled to FIT (which it must be -- "не обрезать" is a standing rule of
+        # this project) almost never has the aspect of the box it lands in, so
+        # it comes with empty margins. Putting the readings in reserved bands
+        # means the picture is fitted into what is left, i.e. the text is in the
+        # margin BY CONSTRUCTION and cannot land on the model whatever the
+        # preview's proportions are. No text-shadow (mud at 114 ppi), no Pango
+        # outline (does not exist), no translucent plaque (nothing to hide) --
+        # the readability problem is designed out instead of mitigated.
+        #
+        # WHERE THE HEIGHT COMES FROM. Measured, not computed: the content area
+        # of this panel allocates 286x212 at (34,28) -- logged live on
+        # 2026-07-31 -- while KlippyGtk's own content_height says 224. The 12px
+        # difference is exactly what sliced the "Fine Tuning" label off the
+        # bottom edge the last time this page was sized off content_height.
+        # 212 = 28 (top band) + ~148 (image) + 36 (bottom band). There is no
+        # separate 47px action row in that budget in ANY state: the actions are
+        # compact icons sharing the bottom band's second line with the
+        # percentage and the file name (see create_buttons). That row used to be
+        # 22% of the screen, permanently.
+        #
+        # The 148 is a starting request only. The real allocation is whatever
+        # GTK hands the image container, and _on_thumb_area_allocate re-decodes
+        # the preview at that size, so the arithmetic above cannot go stale
+        # against a theme change or a different screen.
+        # =====================================================================
+
+        # --- top band: how the job is going ----------------------------------
+        # Time remaining at the top of the scale, then the two readings that
+        # answer "is it going normally" at the bottom of it, right-aligned
+        # against the same edge. Putting layer and temperatures HERE rather than
+        # in the bottom strip is what leaves the strip enough width for a
+        # Details button with its word on it -- the user's original complaint
+        # about the details view was that it was an invisible tap zone, and an
+        # unlabelled glyph is only half a fix for that.
+        self.labels["m_time"] = Gtk.Label(label="-", xalign=0.0)
+        self.labels["m_time"].get_style_context().add_class("js-xl")
+        self.labels["m_layer"] = Gtk.Label(label="", xalign=1.0)
+        self.labels["m_layer"].get_style_context().add_class("js-caption")
+        self.labels["m_temps"] = Gtk.Label(
+            label="", xalign=1.0, ellipsize=Pango.EllipsizeMode.END
+        )
+        self.labels["m_temps"].get_style_context().add_class("js-caption")
+        top = Gtk.Box(spacing=8)
+        top.set_size_request(-1, 28)
+        top.pack_start(self.labels["m_time"], False, False, 0)
+        top.pack_end(self.labels["m_temps"], False, False, 0)
+        top.pack_end(self.labels["m_layer"], False, False, 0)
+
+        # --- the image, and its stand-in when the slicer embedded no preview --
+        # A Gtk.DrawingArea that blits the pixbuf, NOT a Gtk.Image, and not the
+        # Gtk.Button of rev 2. Caught live: with a Gtk.Image the page RATCHETS
+        # its own height. A Gtk.Image's minimum size is its pixbuf's size, and
+        # the pixbuf here is decoded to fill whatever the area was last
+        # allocated -- so one transient over-allocation (any moment the bottom
+        # band has not been sized yet) becomes a permanent minimum, the page
+        # minimum grows past 212px, and what falls off the bottom edge is the
+        # progress strip. Seen in the paused-state screenshot: "45% L 0/150"
+        # sliced in half by the screen edge.
+        #
+        # A DrawingArea requests nothing at all. It takes the height it is
+        # given, the picture is painted centred inside it, and the geometry can
+        # only ever flow one way -- layout decides, image obeys.
+        self.labels["m_image"] = Gtk.DrawingArea(hexpand=True, vexpand=True)
+        self.labels["m_image"].connect("draw", self.on_draw_thumbnail)
+        self._thumb_pixbuf = None
+
+        # The no-preview stand-in. It must be the QUIETEST thing on the page,
+        # not the loudest: rev 2 fell back to the theme's "file" glyph rendered
+        # at thumbnail size, i.e. a teal diamond filling the whole box, which
+        # made "this file has no preview" the most eye-catching state the
+        # screen could be in. 24px outline glyph, the file name under it, the
+        # whole group at 35% opacity -- present, legible, ignorable.
+        placeholder = Gtk.Box(
+            orientation=Gtk.Orientation.VERTICAL,
+            spacing=6,
+            halign=Gtk.Align.CENTER,
+            valign=Gtk.Align.CENTER,
+        )
+        placeholder.add(self._gtk.Image("file", 24, 24))
+        self.labels["m_placeholder_text"] = Gtk.Label(
+            label="", justify=Gtk.Justification.CENTER, ellipsize=Pango.EllipsizeMode.END
+        )
+        # max_width_chars bounds the NATURAL width. Without it a long file name
+        # makes the placeholder ask for more width than the screen has, and this
+        # box is the only child of the image region with a size request at all.
+        self.labels["m_placeholder_text"].set_max_width_chars(22)
+        self.labels["m_placeholder_text"].get_style_context().add_class("js-caption")
+        placeholder.add(self.labels["m_placeholder_text"])
+        placeholder.set_opacity(0.35)
+        placeholder.set_no_show_all(True)
+        self.labels["m_placeholder"] = placeholder
+
+        # Overlay, not a Box: the stand-in has to sit in the SAME place the
+        # picture would, and only one of the two is ever visible. no_show_all on
+        # the placeholder because this panel is show_all()'d from several places
+        # outside itself, every one of which would otherwise draw the "no
+        # preview" glyph on top of a perfectly good model.
+        thumb_area = Gtk.Overlay(hexpand=True, vexpand=True)
+        thumb_area.add(self.labels["m_image"])
+        thumb_area.add_overlay(self.labels["m_placeholder"])
+        thumb_area.connect("size-allocate", self._on_thumb_area_allocate)
+        self._thumb_area = thumb_area
+
+        # --- bottom band -----------------------------------------------------
+        self.labels["progress_bar"] = Gtk.DrawingArea()
+        self.labels["progress_bar"].set_size_request(-1, 8)
+        self.labels["progress_bar"].set_valign(Gtk.Align.CENTER)
+        self.labels["progress_bar"].set_hexpand(True)
+        self.labels["progress_bar"].connect("draw", self.on_draw_bar)
+
+        self.labels["minimal_progress_text"] = Gtk.Label(label="0%", xalign=0.0)
+        self.labels["minimal_progress_text"].get_style_context().add_class("js-caption")
+        self.labels["m_file"] = Gtk.Label(
+            label="", xalign=0.0, hexpand=True, ellipsize=Pango.EllipsizeMode.END
+        )
+        self.labels["m_file"].get_style_context().add_class("js-caption")
+
+        # THE action strip: compact icons, hard against the bottom-right
+        # corner. Every action this panel has lives here, in every state --
+        # which buttons are IN it changes with the state, how it looks never
+        # does. Pause and Resume are two buttons rather than one that swaps its
+        # glyph because KlippyGtk bakes the icon into a GdkPixbuf at
+        # construction time; swapping it at runtime means rebuilding the button
+        # anyway. Order is fixed so a button never moves sideways when its
+        # neighbour appears: destructive-first would put Cancel under the
+        # thumb that just pressed Pause.
+        actions = self._build_action_strip("")
+        strip = Gtk.Box(spacing=8)
+        strip.pack_start(self.labels["minimal_progress_text"], False, False, 0)
+        strip.pack_start(self.labels["m_file"], True, True, 0)
+        strip.pack_start(actions, False, False, 0)
+
+        bottom = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=4)
+        bottom.set_size_request(-1, 36)
+        bottom.pack_start(self.labels["progress_bar"], False, False, 0)
+        bottom.pack_start(strip, False, False, 0)
+
+        self.buttons["to_minimal"] = self._gtk.Button(
+            "back", None, "color1", self.bts, Gtk.PositionType.TOP, False
+        )
+        self.buttons["to_minimal"].set_hexpand(False)
+        self.buttons["to_minimal"].connect("clicked", self.show_minimal)
+
+        page = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=0)
+        page.pack_start(top, False, False, 0)
+        page.pack_start(thumb_area, True, True, 0)
+        page.pack_start(bottom, False, False, 0)
+        self.minimal_grid = page
+
+    def _on_thumb_area_allocate(self, widget, allocation):
+        # Self-tuning image size: whatever GTK actually gives the image region
+        # is what the preview gets decoded at, so the hand-computed 286x148
+        # above is only ever a first guess and cannot rot.
+        #
+        # Two hazards, both paid for elsewhere in this codebase and both real:
+        #   * setting a pixbuf from inside a size-allocate handler re-triggers
+        #     allocation -> loop. Hence the handler is on the CONTAINER, the
+        #     reload is deferred to GLib.idle_add, and a pending reload is
+        #     coalesced with _thumb_reload_pending.
+        #   * KlippyGtk.PixbufFromFile is @lru_cache(maxsize=500) keyed on
+        #     (path, w, h). An unquantised stream of allocations would fill 500
+        #     near-identical ~170KB pixbufs on a 512MB Orange Pi. Quantising to
+        #     8px means the cache holds a handful of entries, and a 4px error in
+        #     the fit is invisible.
+        width = (allocation.width // 8) * 8
+        height = (allocation.height // 8) * 8
+        if width < 32 or height < 32:
+            return
+        if (width, height) == self._thumb_request:
+            return
+        self._thumb_request = (width, height)
+        if not self._thumb_reload_pending:
+            self._thumb_reload_pending = True
+            GLib.idle_add(self._reload_thumbnail)
+
+    def _reload_thumbnail(self):
+        self._thumb_reload_pending = False
+        if not self.content.get_parent():
+            return False
+        if not self.filename or self._thumb_request is None:
+            self._set_big_thumbnail(None)
+            return False
+        width, height = self._thumb_request
+        key = (self.filename, width, height)
+        if key == self._thumb_loaded:
+            return False
+        self._thumb_loaded = key
+        # Preferred path: trim the preview's transparent margin, then fit.
+        # Measured on this machine's own files (OrcaSlicer 2.4.2, 300x300 PNG):
+        # the model's real bounding box is 238x251 and it is not even centred
+        # (46px of empty pixels on the left, 16 on the right). Fitting the raw
+        # 300x300 into the 286x148 region therefore spends 20% of the height on
+        # nothing and lands the model off-centre. Trimming FULLY TRANSPARENT
+        # rows and columns only is not cropping -- not one pixel of the model is
+        # touched, which is the standing rule here ("но не обрезать её за
+        # границы экрана!") -- and it makes the model 148px tall instead of
+        # 124px, i.e. 40% more area, for free.
+        if self._load_trimmed_async(self.filename, width, height):
+            return False
+        # Fallback: upstream's loader. new_from_file_at_size() scales to FIT and
+        # preserves the aspect ratio, so this path letterboxes rather than
+        # cropping too -- it just keeps the slicer's empty margin.
+        self.load_image_async(self.filename, width, height, callback=self._set_big_thumbnail)
+        return False
+
+    def _load_trimmed_async(self, filename, width, height):
+        # Returns True if it took the job, False to let the caller fall back.
+        # Everything that can be unknown here (no thumbnail, an HTTP-served one,
+        # a GdkPixbuf failure) returns False rather than guessing.
+        if not self._files.has_thumbnail(filename):
+            return False
+        loc = self._files.get_thumbnail_location(filename, False)
+        if loc is None or loc[0] != "file":
+            return False
+        path = loc[1]
+
+        def _work():
+            try:
+                pixbuf = self._trimmed_source(path)
+                if pixbuf is None:
+                    GLib.idle_add(self._set_big_thumbnail, None)
+                    return
+                sw, sh = pixbuf.get_width(), pixbuf.get_height()
+                scale = min(width / sw, height / sh)
+                # Never enlarge: a 300px preview blown up to 400px on a 114 ppi
+                # panel is just a blurry 300px preview.
+                scale = min(scale, 1.0)
+                target_w = max(int(sw * scale), 1)
+                target_h = max(int(sh * scale), 1)
+                if (target_w, target_h) != (sw, sh):
+                    pixbuf = pixbuf.scale_simple(
+                        target_w, target_h, GdkPixbuf.InterpType.BILINEAR
+                    )
+                GLib.idle_add(self._set_big_thumbnail, pixbuf)
+            except Exception as e:
+                logging.exception(f"Trimmed thumbnail failed, falling back: {e}")
+                GLib.idle_add(
+                    self.load_image_async, filename, width, height, False, self._set_big_thumbnail
+                )
+
+        # Same thread pool upstream's load_image_async uses: decoding a 300x300
+        # PNG plus the row/column scan below is ~100ms on this H3, and the UI
+        # thread also drives a 500ms marquee timer.
+        self._gtk._executor.submit(_work)
+        return True
+
+    def _trimmed_source(self, path):
+        # Cached per file: the panel re-requests the image whenever its
+        # allocation changes (theme switch, page switch), and there is no reason
+        # to re-decode and re-scan for that. One 238x251 RGBA pixbuf is ~240KB;
+        # this machine has 512MB and the cache holds exactly one entry.
+        if self._trim_cache and self._trim_cache[0] == path:
+            return self._trim_cache[1]
+        pixbuf = self._gtk.PixbufFromFile(path, -1, -1)
+        if pixbuf is None:
+            return None
+        if pixbuf.get_has_alpha() and pixbuf.get_n_channels() == 4:
+            box = self._alpha_bbox(pixbuf)
+            if box is not None:
+                x0, y0, x1, y1 = box
+                if (x1 - x0 + 1, y1 - y0 + 1) != (pixbuf.get_width(), pixbuf.get_height()):
+                    pixbuf = pixbuf.new_subpixbuf(x0, y0, x1 - x0 + 1, y1 - y0 + 1)
+        self._trim_cache = (path, pixbuf)
+        return pixbuf
+
+    @staticmethod
+    def _alpha_bbox(pixbuf, threshold=8):
+        # Bounding box of everything that is not fully transparent.
+        #
+        # Written as slices on purpose: a per-pixel Python loop over 90 000
+        # pixels takes seconds on an H3. data[y*rs+3 : y*rs+w*4 : 4] is one
+        # row's alpha channel, and data[x*4+3 : h*rs : rs] is one COLUMN's
+        # (stride rs steps exactly one row down at the same x). That is 600
+        # C-level slice+max operations instead of 90 000 interpreter steps.
+        data = pixbuf.get_pixels()
+        width, height, rs = pixbuf.get_width(), pixbuf.get_height(), pixbuf.get_rowstride()
+        rows = [y for y in range(height) if max(data[y * rs + 3 : y * rs + width * 4 : 4]) > threshold]
+        if not rows:
+            return None
+        cols = [x for x in range(width) if max(data[x * 4 + 3 : height * rs : rs]) > threshold]
+        if not cols:
+            return None
+        return cols[0], rows[0], cols[-1], rows[-1]
+
+    # Which buttons the action strip carries in each print state. Everything
+    # upstream expressed by tearing a Gtk.Grid down and re-attaching four
+    # children per state is expressed here as membership of a set -- the strip
+    # itself never changes, only what is in it. That is the "одинаково во всех
+    # состояниях" requirement made structural instead of remembered.
+    #
+    # `standby` here means "no job running", which covers complete, cancelled,
+    # error and a fresh boot alike; the Z-offset pair is added to it
+    # conditionally, since it depends on the offset and on what the firmware
+    # actually supports.
+    ACTIONS_BY_STATE = {
+        "printing": ("pause", "cancel", "fine_tune", "control", "details"),
+        "paused": ("resume", "cancel", "fine_tune", "control", "details"),
+        "cancelling": ("resume", "cancel", "restart", "details", "menu"),
+        "idle": ("restart", "details", "menu"),
+    }
+    # Every key the strip can hold, in no particular order -- _sync_actions
+    # iterates this to decide what to hide, so a button missing from here would
+    # simply never turn off again.
+    ACTION_KEYS = (
+        "pause",
+        "resume",
+        "cancel",
+        "fine_tune",
+        "control",
+        "restart",
+        "menu",
+        "details",
+        "save_offset_endstop",
+        "save_offset_probe",
+    )
+    # The strip exists TWICE: once on the minimal page, once on the detailed
+    # one. «просто его используй везде» read literally -- so the second one is
+    # not a new control, it is the same strip on the other page: same
+    # _action_button factory, same icons, same .js-action class, same order,
+    # same ACTIONS_BY_STATE membership. The detailed page's copies are keyed
+    # with a "d_" prefix in self.buttons and differ in nothing else.
+    #
+    # Two widgets rather than one moved between pages because a GtkWidget has
+    # exactly one parent: re-parenting on every page switch would mean
+    # remove()/add() inside the Stack transition, which is the kind of thing
+    # that works until the day it flickers.
+    ACTION_PREFIXES = ("", "d_")
+    # Fixed left-to-right order, so a button never slides sideways when its
+    # neighbour appears or goes away.
+    ACTION_ORDER = (
+        "pause",
+        "resume",
+        "cancel",
+        "save_offset_endstop",
+        "save_offset_probe",
+        "restart",
+        "fine_tune",
+        "control",
+        "details",
+        "menu",
+    )
+
+    def _sync_actions(self):
+        wanted = set(self.ACTIONS_BY_STATE.get(self.state, self.ACTIONS_BY_STATE["idle"]))
+        if self.state in ("printing", "paused", "cancelling"):
+            self.can_close = False
+        else:
+            # Post-job: offer to write the live Z offset back to the config, but
+            # only if there is one and only for the mechanism this firmware
+            # actually has. Asking Klipper (available_commands) rather than
+            # assuming: this machine's z_offset_guard module can reject
+            # Z_OFFSET_APPLY_ENDSTOP outright.
+            offset = self._printer.get_stat("gcode_move", "homing_origin")
+            self.zoffset = float(offset[2]) if offset else 0
+            if self.zoffset != 0:
+                if "Z_OFFSET_APPLY_ENDSTOP" in self._printer.available_commands:
+                    wanted.add("save_offset_endstop")
+                if "Z_OFFSET_APPLY_PROBE" in self._printer.available_commands:
+                    wanted.add("save_offset_probe")
+            if not self.filename:
+                wanted.discard("restart")
+            self.can_close = True
+
+        for prefix in self.ACTION_PREFIXES:
+            # The detailed page's twin drops "details", and only that: it points
+            # at the page you are already standing on. On a five-button pad a
+            # control that does nothing is not harmless -- it is one more stop
+            # the focus has to walk past to reach Cancel. Everything else about
+            # the two strips is identical, deliberately.
+            here = wanted - {"details"} if prefix else wanted
+            for key in self.ACTION_KEYS:
+                button = self.buttons.get(prefix + key)
+                if button is None:
+                    continue
+                if key in here:
+                    # no_show_all is what stops the panel-wide show_all() calls
+                    # from putting Pause back on a finished job, and
+                    # gtk_widget_show_all() returns immediately on a widget
+                    # carrying that flag -- so it has to come off for the
+                    # duration of the call. .show() alone would reveal a button
+                    # whose icon child has never been shown.
+                    button.set_no_show_all(False)
+                    button.show_all()
+                    button.set_no_show_all(True)
+                    button.set_sensitive(True)
+                else:
+                    button.hide()
+        # A cancel in flight: the spinner replaces the icon (this works again
+        # now that these buttons HAVE icons -- KlippyGtk only builds the
+        # Gtk.Spinner for a button with an image), and nothing that would race
+        # the cancel stays pressable. Both strips, or the page you happen not to
+        # be looking at keeps offering a live Cancel for a cancel already
+        # running.
+        for twin in self._action_twins("cancel"):
+            self._gtk.Button_busy(twin, self.state == "cancelling")
+        if self.state == "cancelling":
+            self.disable_button("resume", "restart", "menu")
+
+    def show_minimal(self, widget=None):
+        self.stack.set_visible_child_name("minimal")
+        self._sync_actions()
+
+    def show_detailed(self, widget=None, info=None):
+        # widget is the clicked button when this is used as a signal handler,
+        # and Gtk passes no second argument then -- but show_detailed is ALSO
+        # connected with a user-data grid (m_layer used to do that), so `info`
+        # has to tolerate being a widget rather than a grid.
+        self.switch_info(info=info if isinstance(info, Gtk.Widget) else self.status_grid)
+        self.stack.set_visible_child_name("detailed")
+        self._sync_actions()
+
+    def back(self):
+        # 2026-08-17 -- THE ESCAPE HATCH. Bug report, verbatim: "кажется в
+        # некоторых режимах из него невозможно выйти. я даже сделал экстренный
+        # стоп просто чтобы перезагрузить экран". Confirmed from the device's
+        # own KlipperScreen.log, 11:31:57 - 11:32:19: four BackSpace presses,
+        # each logged as "#### Menu go back", each doing nothing, then
+        # `MoonrakerApi.emergency_stop`. He had to kill the printer to get off
+        # this screen. Mechanism: state_printing() opens this panel with
+        # remove_all=True, so _cur_panels == ["job_status"] and _menu_go_back()
