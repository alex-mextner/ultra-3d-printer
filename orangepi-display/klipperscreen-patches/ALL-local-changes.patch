+        dismiss = self.dialog_dismiss_button(dialog, buttons)
+        if dismiss is not None:
+            dialog.set_focus(dismiss)
+            dismiss.grab_focus()
+            logging.info(f"Dialog initial focus set to {dismiss.get_label()}")
         # Change cursor to blank
         self.set_cursor(show=self.screen.show_cursor, window=dialog.get_window())
 
