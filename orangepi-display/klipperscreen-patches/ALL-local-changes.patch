+    def _state_rgb(self):
+        # 2026-08-17: the bar used to be red at every progress on every state,
+        # including a print running perfectly normally. Red is the one colour a
+        # machine that can set itself on fire should reserve for trouble.
+        if self.state == "paused":
+            return 0.90, 0.62, 0.12
+        # Cancelled is not an alarm, and this line was the last place the code
+        # still disagreed with the spec table in docs/klipperscreen-design.md:
+        # cancelled shared #B71C1C with error, so calling a print off painted
+        # the same bar as a firmware fault. The spec gives it @lines (#6B7178)
+        # exactly so that red keeps meaning trouble. `cancelling` rides with
+        # `cancelled` rather than with `error` -- it is the same event one
+        # second earlier, and a bar that flashes red and then turns grey reads
+        # as "something broke, then un-broke".
+        if self.state in ("cancelled", "cancelling"):
+            return 0.420, 0.443, 0.471
+        # #981E1F, the spec's @error, and now the only red left on this screen.
+        if self.state == "error":
+            return 0.596, 0.118, 0.122
+        if self.state == "complete":
+            return 0.16, 0.65, 0.35
+        return 0.05, 0.60, 0.55
