+        # "System / Shutdo...", i.e. it lost text, not just prettiness. Nothing
+        # shorter keeps the word ("Shutdown" is 70px on its own), so the word
+        # itself had to go. "Power Off" is 43px per word, wraps cleanly at the
+        # space here and fits on ONE line in the 3-button layout (68px of 90).
+        # Matches the button's existing power-symbol icon.
+        self.labels["shutdown"] = self._gtk.Button("shutdown", _("Power Off"), "color2")
         self.labels["shutdown"].connect("clicked", self.reboot_poweroff, "shutdown")
         self.labels["retry"] = self._gtk.Button("load", _("Retry"), "color3")
         self.labels["retry"].connect("clicked", self.retry)
@@ -88,7 +98,13 @@
         self.labels["actions"].show_all()
 
     def add_power_button(self, powerdevs):
-        self.labels["power"] = self._gtk.Button("shutdown", _("Power On Printer"), "color3")
+        # 2026-08-18: was _("Power On Printer") -- three words into a 2-line
