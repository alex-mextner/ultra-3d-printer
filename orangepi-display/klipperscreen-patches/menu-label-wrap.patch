--- a/config/main_menu.conf
+++ b/config/main_menu.conf
@@ -11,7 +11,32 @@
 panel: move
 
 [menu __main temperature]
-name: {{ gettext('Temperature') }}
+# 2026-08-18: was "Temperature". Measured on this panel, not guessed: the word
+# renders 90px wide at the theme's 14px, and the label slot is 89px in this
+# 3-column __main menu and 66px in the 4-column __print one. panels/menu.py
+# builds every menu item with KlippyGtk.Button's default lines=2, which sets
+# Pango WrapMode.WORD_CHAR -- and WORD_CHAR breaks INSIDE a word that does not
+# fit, with no space to break at. Result before this change: "Temperatur-/e"
+# here and "Temper-/ature" in Print Control.
+#
+# lines=1 is NOT the fix and was rejected after measuring: at 66px it only
+# swaps the mid-word break for an ellipsis ("Temperat..."), equally unreadable.
+# The remedy is the one already used by `settings` further down (which was
+# "KlipperScreen" and char-wrapped as "KlipperS-/creen"): shorten the label in
+# the menu config, leave the shared wrap mechanism alone.
+#
+# Honest cost, and it is the INVERSE of that precedent: renaming to "Settings"
+# GAINED a translation, renaming to "Temp" LOSES one. "Temperature" is msgid in
+# all 32 bundled catalogues; "Temp" is in none, so gettext() returns it
+# unchanged. Acceptable only because this device is English-only
+# (LANG=en_US.UTF-8; KlipperScreen.log: "Selected lang: system_lang OS lang:
+# en_US") and the alternative is a label that cannot be read at all. Revisit if
+# the UI language ever changes -- do not "restore" it without re-measuring.
+#
+# Not visible on the dashboard either way: in landscape main_menu.py hides
+# every label in its icon-only bottom row. This label is what the __main menu
+# shows when it is opened as a real menu panel (via _go_to_submenu).
+name: {{ gettext('Temp') }}
 icon: heat-up
 panel: temperature
 enable: {{ (printer.temperature_devices.count > 0) or (printer.extruders.count > 0)}}
--- a/config/print_menu.conf
+++ b/config/print_menu.conf
@@ -6,7 +6,12 @@
 name: {{ gettext('Print Control') }}
 
 [menu __print temperature]
-name: {{ gettext('Temperature') }}
+# 2026-08-18: was "Temperature", char-wrapped as "Temper-/ature" in this
+# 4-column menu (word 90px, label slot 66px). Full rationale, the measurements
+# and the honest translation cost are in config/main_menu.conf on the twin of
+# this entry; both menus have to change together or the same word stays broken
+# on whichever one was missed.
+name: {{ gettext('Temp') }}
 icon: heat-up
 panel: temperature
 enable: {{ (printer.temperature_devices.count > 0) or (printer.extruders.count > 0)}}
--- a/panels/splash_screen.py
+++ b/panels/splash_screen.py
@@ -33,7 +33,17 @@
         self.labels["firmware_restart"].connect("clicked", self.firmware_restart)
         self.labels["restart_system"] = self._gtk.Button("refresh", _("System Restart"), "color1")
         self.labels["restart_system"].connect("clicked", self.reboot_poweroff, "reboot")
-        self.labels["shutdown"] = self._gtk.Button("shutdown", _("System Shutdown"), "color2")
+        # 2026-08-18: was _("System Shutdown"). This row is a homogeneous Box
+        # across the full content width, so with four buttons (the
+        # not-initialized branch plus Retry) each one is 72px, leaving a 66px
+        # label slot -- and "Shutdown" alone measures 70px. With lines=2 that
