+    def _scrollable_ancestor(self, widget, candidates):
+        # Which of the collected scrolled windows actually contains this
+        # widget, so a reveal scrolls the viewport the widget is really in.
+        # Returns None when the newly focused widget sits outside every
+        # list -- e.g. the console's command entry, which is a sibling of
+        # the log, not a row inside it. Scrolling `target` in that case
+        # would move a viewport the user is not even in.
+        for sw in candidates:
+            try:
+                if widget is sw or widget.is_ancestor(sw):
+                    return sw
+            except Exception:
+                continue
+        return None
