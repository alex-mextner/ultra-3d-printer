+    def _build_button_row(self, items):
+        """Lay out `items` as a single homogeneous row spanning full width.
+
+        Stand-in for arrangeMenuItems()/AutoGrid for this one case (see the
+        comment at the call site): a plain Gtk.Grid with one row and one
+        column per enabled item, all equally sized and expanding to fill
+        the available width edge-to-edge.
+        """
+        enabled = []
+        for item in items:
+            key = list(item)[0]
+            if not self.evaluate_enable(item[key]["enable"]):
+                continue
+            if item[key]["panel"] and self._is_shortcut_item(item[key]):
+                continue
+            enabled.append(self.labels[key])
+        row = Gtk.Grid(row_homogeneous=True, column_homogeneous=True, hexpand=True, vexpand=False)
+        for i, widget in enumerate(enabled):
+            row.attach(widget, i, 0, 1, 1)
+        return row
