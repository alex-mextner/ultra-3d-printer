     def preheat(self):
+        # 2026-07-31 right-panel overflow fix, continued: was a 2-column grid
+        # (PLA|ABS / PETG|FLEX), which on the ~79px budget available here
+        # left each button ~35px wide -- entire second column (ABS/FLEX) was
+        # rendering past the screen's right edge, fully invisible, same bug
+        # as the "Cooldown" clipping above. Single column instead: each
+        # preset button gets the full available width (still tight enough to
+        # wrap PLA/ABS/PETG/FLEX onto two lines rather than fit on one, but
+        # every character stays on-screen and reachable), the extra vertical
+        # length scrolls via the existing ScrolledWindow instead of needing
+        # horizontal room. The scroll's own width fix is below.
         self.labels["preheat_grid"] = Gtk.Grid(row_homogeneous=True, column_homogeneous=True)
         i = 0
         for option in self.preheat_options:
             if option != "cooldown":
                 self.labels[option] = self._gtk.Button(label=option, style=f"color{(i % 4) + 1}")
                 self.labels[option].connect("clicked", self.set_temperature, option)
-                self.labels["preheat_grid"].attach(self.labels[option], (i % 2), int(i / 2), 1, 1)
+                self.labels["preheat_grid"].attach(self.labels[option], 0, i, 1, 1)
                 i += 1
         scroll = self._gtk.ScrolledWindow()
+        # Without this, CustomScrolledWindow's own preferred-width query
+        # (confirmed live) reported minimum_width == natural_width == 141px
+        # regardless of preheat_grid's actual (much smaller) content width --
+        # a GtkScrolledWindow reserves room for a possible horizontal
+        # scrollbar/natural-width propagation unless told not to. NEVER
+        # forecloses horizontal scrolling entirely (not needed, single column
+        # now), and the two width calls pin the scrolled window to its
+        # child's real minimum instead of that inflated floor.
+        scroll.set_policy(Gtk.PolicyType.NEVER, Gtk.PolicyType.AUTOMATIC)
+        scroll.set_min_content_width(1)
+        scroll.set_propagate_natural_width(False)
+        # THE decisive one for legibility (2026-07-31, second pass after a
+        # review caught the labels still wrapping as "P-"/"LA"): this is a
+        # CustomScrolledWindow (ks_includes/widgets/scroll.py), which sets
+        # `overlay_scrolling: False` by default -- so its vertical scrollbar
+        # takes REAL layout width out of the ~77px this column gets, leaving
+        # preheat_grid just 30px against a 49px natural width (measured live).
+        # At 30px, Pango falls back to WORD_CHAR character-level wrapping and
+        # "PLA" renders as "P-" / "LA" on two lines. base.css sizes that
+        # scrollbar `scrollbar slider {min-width: 2.5em}` == ~35px at this
+        # theme's 14px font -- nearly half the column. Overlay scrolling draws
+        # it on top of the content instead of beside it, costing zero layout
+        # width; identical reasoning and identical fix to the one already
+        # applied to the main menu (main-menu-single-column.patch), and the
+        # auto-hide behaviour it brings is a non-issue on a D-pad-only kiosk
+        # with no mouse hover.
+        scroll.set_overlay_scrolling(True)
         scroll.add(self.labels["preheat_grid"])
         return scroll
 
