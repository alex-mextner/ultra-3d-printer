+        # Hanging indent so a wrapped continuation line lands under the
+        # message text (after "HH:MM:SS ") instead of back at the far-left
+        # margin, where it reads as a stray/unrelated entry (GitHub #6).
+        # GTK3 CSS has no text-indent equivalent -- this is the Gtk.TextTag
+        # indent property, applied to every inserted entry in
+        # add_notification(). Width is (re)computed in _update_indent()
+        # against the panel's actual font, so it tracks theme/font changes
+        # instead of a hardcoded guess.
+        self.indent_tag = self.tb.create_tag("hanging_indent")
+        self.tv = Gtk.TextView(editable=False, cursor_visible=False, wrap_mode=Pango.WrapMode.WORD_CHAR)
+        self.tv.set_buffer(self.tb)
+        self.tv.connect("size-allocate", self._autoscroll)
 
         scroll = Gtk.ScrolledWindow(hexpand=True, vexpand=True)
-        scroll.add(tv)
+        scroll.add(self.tv)
 
         clear_button = self._gtk.Button(
             "refresh", _("Clear") + " ", None, self.bts, Gtk.PositionType.RIGHT, 1
@@ -43,8 +52,15 @@ class Panel(ScreenPanel):
