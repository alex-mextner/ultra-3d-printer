+    def _reset_focus_clear_timeout(self):
+        # This is a 5-button D-pad, not a touchscreen: focus only exists to
+        # show where a button/arrow press will land. Leaving the highlight
+        # on indefinitely after the last press makes an otherwise idle,
+        # at-rest screen look like something is stuck/selected, so clear it
+        # after a few seconds of no further input instead.
+        if self._focus_clear_timeout_id is not None:
+            GLib.source_remove(self._focus_clear_timeout_id)
+        self._focus_clear_timeout_id = GLib.timeout_add_seconds(10, self._clear_focus_on_timeout)
+
+    def _clear_focus_on_timeout(self):
+        self.set_focus(None)
+        self._focus_clear_timeout_id = None
+        return False
 
