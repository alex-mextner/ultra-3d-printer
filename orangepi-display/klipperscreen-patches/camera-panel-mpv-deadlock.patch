 from ks_includes.screen_panel import ScreenPanel
 
+# Why this panel no longer uses mpv (2026-08-01)
+# -----------------------------------------------------------------------------
+# Upstream camera.py handed the stream to libmpv and then called
+# `self.mpv.wait_for_playback()`. That call blocks the calling thread until
+# playback ENDS -- and it ran on the GTK main thread, because play() is reached
+# either from a "clicked" handler or from activate(), which screen.py invokes
+# inside attach_panel(). So entering the camera panel parked the main loop for
+# as long as the stream lived, i.e. forever for a live camera. Nothing was
+# dispatched any more: no key presses, no redraws, no Moonraker updates.
+# Measured on this device: after "VO: [gpu] 640x480 yuvj422p" the KlipperScreen
+# log went completely silent for 2m08s, until the user restarted the service.
+# Injected `xdotool key BackSpace Down Left Left` produced not one line, even
+# though _key_press_event() traces every single press unconditionally.
+#
+# That alone bricks the panel, and a second, independent defect made it
+# unrecoverable: mpv opened its own fullscreen X window over KlipperScreen, and
+# the only exit binding upstream registers is
+#     @self.mpv.on_key_press("MBTN_LEFT" or "MBTN_LEFT_DBL")
+# -- a Python bug (`or` between two non-empty strings yields the first) that in
+# any case binds a LEFT MOUSE CLICK. This machine has five GPIO buttons, no
+# touchscreen and no mouse. There was literally no input that could close it;
+# `systemctl restart KlipperScreen` was the only way out, and the user got
+# trapped twice.
+#
+# Both defects come from the same assumption -- a touchscreen and a GPU -- so
+# the fix is not to patch mpv's options but to drop the second window and the
+# blocking call entirely. This panel now polls the MJPEG snapshot endpoint on a
+# worker thread and paints frames into an ordinary Gtk.Image inside the normal
+# KlipperScreen window. The main loop is never blocked, no foreign window ever
+# takes the input focus, and BackSpace/Escape therefore always leave the panel
+# -- including when the camera is unplugged, crowsnest is stopped, or the URL
+# is wrong. On a device whose only UI is five buttons, "you can always get out"
+# is worth more than smooth video.
+#
+# Cost measured on this Orange Pi One (H3, 512MB), 640x480 MJPEG from ustreamer
+# over loopback, 20 samples: 46KB per frame, 112ms fetch, 20ms decode+scale to
+# 283x212 (median). Both of those run on the worker thread; the main loop only
+# swaps the finished pixbuf into the Gtk.Image. Resident cost is a couple of
+# hundred KB of pixbuf, against ~176MB RSS for the mpv/software-GL path that
+# used to push this 484MB box to 8MB free.
+
+# The ILI9341 is a 320x240 panel on SPI -- it cannot usefully show more than a
+# few frames per second, and one fetch+decode round trip already costs ~130ms
+# here, so this ceiling is barely ever reached. It exists to stop a fast local
+# camera from spinning the worker at 100% CPU.
+TARGET_FPS = 5
+HTTP_TIMEOUT = 5
+# Retry pause after a failed fetch. Long enough that a missing camera does not
+# hammer the CPU, short enough that plugging it back in recovers by itself.
+RECONNECT_DELAY = 3.0
+IDLE_POLL = 1.0
+
+# Moonraker stores rotation as degrees clockwise; GdkPixbuf names its enum by
+# direction, so 90 clockwise is PixbufRotation.CLOCKWISE (270 in the enum).
+# Mapping them by name rather than by number avoids that off-by-a-quarter-turn.
+ROTATIONS = {
+    90: GdkPixbuf.PixbufRotation.CLOCKWISE,
+    180: GdkPixbuf.PixbufRotation.UPSIDEDOWN,
+    270: GdkPixbuf.PixbufRotation.COUNTERCLOCKWISE,
+}
+
+
+class SnapshotStream:
+    """Polls an MJPEG snapshot endpoint on a worker thread.
+
+    Everything expensive -- the HTTP round trip and the JPEG decode/scale --
+    happens off the GTK main loop. The main loop only ever swaps an
+    already-decoded GdkPixbuf into a Gtk.Image, so the UI keeps responding no
+    matter what the camera does.
+    """
+
+    def __init__(self, url, max_size, on_frame, on_status, gate=None,
+                 fps=TARGET_FPS, flip_h=False, flip_v=False, rotation=0):
+        self.url = url
+        self._max_w, self._max_h = max_size
+        self._on_frame = on_frame
+        self._on_status = on_status
+        self._gate = gate
+        self._period = 1.0 / max(1, fps)
+        self._flip_h = flip_h
+        self._flip_v = flip_v
+        self._rotation = ROTATIONS.get(rotation)
+        if rotation and self._rotation is None:
+            logging.info(f"camera: ignoring unsupported rotation {rotation}")
+        # A quarter turn swaps the axes, so decode into the transposed box to
+        # end up filling the real one.
+        if rotation in (90, 270):
+            self._max_w, self._max_h = self._max_h, self._max_w
+        self._stop = threading.Event()
+        self._lock = threading.Lock()
+        self._pending = None
+        self._idle_queued = False
+        self._thread = None
+
+    def start(self):
+        if self._thread is not None:
+            return
+        self._thread = threading.Thread(target=self._run, daemon=True, name="camera-stream")
+        self._thread.start()
+
+    def stop(self):
+        # Deliberately no join(): this is called from the GTK main loop and the
+        # worker may be sitting in a socket read. Blocking here would recreate
+        # the very bug this panel exists to fix. The thread is a daemon, checks
+        # _stop after every step, and both delivery paths drop everything once
+        # _stop is set, so a straggler frame can never reach a dead panel.
+        self._stop.set()
+        with self._lock:
+            self._pending = None
+
+    def _run(self):
+        announced = False
+        while not self._stop.is_set():
+            if self._gate is not None and not self._gate():
+                # Screen is blanked or the panel is no longer on top -- do not
+                # burn CPU decoding frames nobody can see.
+                self._stop.wait(IDLE_POLL)
+                continue
+            started = time.monotonic()
+            try:
+                with urllib.request.urlopen(self.url, timeout=HTTP_TIMEOUT) as response:
+                    data = response.read()
+                pixbuf = self._decode(data)
+            except Exception as exception:  # noqa: BLE001 - any failure must degrade, not raise
+                if self._stop.is_set():
+                    return
+                logging.info(f"camera: snapshot fetch failed: {exception}")
+                self._status(_("Camera not available"))
+                announced = False
+                self._stop.wait(RECONNECT_DELAY)
+                continue
+            if pixbuf is None:
+                logging.info("camera: could not decode snapshot")
+                self._status(_("Camera not available"))
+                announced = False
+                self._stop.wait(RECONNECT_DELAY)
+                continue
+            if not announced:
+                self._status(None)
+                announced = True
+            self._publish(pixbuf)
+            elapsed = time.monotonic() - started
+            if elapsed < self._period:
+                self._stop.wait(self._period - elapsed)
+
+    def _decode(self, data):
+        loader = GdkPixbuf.PixbufLoader.new_with_type("jpeg")
+        loader.connect("size-prepared", self._on_size_prepared)
+        try:
+            loader.write(data)
+        finally:
+            # close() raises on a truncated JPEG; the partial pixbuf (or None)
+            # is all we need and a dropped frame is not worth an exception.
+            with suppress(GLib.GError):
+                loader.close()
+        pixbuf = loader.get_pixbuf()
+        if pixbuf is None:
+            return None
+        if self._rotation is not None:
+            pixbuf = pixbuf.rotate_simple(self._rotation) or pixbuf
+        if self._flip_h:
+            pixbuf = pixbuf.flip(True) or pixbuf
+        if self._flip_v:
+            pixbuf = pixbuf.flip(False) or pixbuf
+        return pixbuf
+
+    def _on_size_prepared(self, loader, src_width, src_height):
+        # Scale during decode rather than after: GdkPixbuf then never
+        # materialises the full-size image, which is both faster and smaller.
+        # Derived from the real frame dimensions, not from the camera's
+        # declared aspect_ratio, so a misconfigured ratio cannot squash it.
+        if src_width <= 0 or src_height <= 0:
+            return
+        scale = min(self._max_w / src_width, self._max_h / src_height)
+        loader.set_size(max(1, int(src_width * scale)), max(1, int(src_height * scale)))
+
+    def _publish(self, pixbuf):
+        with self._lock:
+            # Single-slot handoff: a new frame overwrites an undelivered one
+            # instead of queueing behind it. On an SPI display the main loop
+            # can fall behind the worker, and one idle callback per frame would
+            # pile up pixbufs and show stale video. Overwriting gives free
+            # frame-skipping instead.
+            self._pending = pixbuf
+            if self._idle_queued:
+                return
+            self._idle_queued = True
+        GLib.idle_add(self._deliver)
+
+    def _deliver(self):
+        with self._lock:
+            pixbuf, self._pending, self._idle_queued = self._pending, None, False
+        if pixbuf is not None and not self._stop.is_set():
+            self._on_frame(pixbuf)
+        return False
+
+    def _status(self, message):
+        if self._stop.is_set():
+            return
+        GLib.idle_add(self._emit_status, message)
+
+    def _emit_status(self, message):
+        if not self._stop.is_set():
+            self._on_status(message)
+        return False
+
 
