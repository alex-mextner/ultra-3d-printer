+    def _confirm_send_action_response(self, dialog, response_id, method, params, widget=None):
+        # 2026-08-15: `widget` (the caller's own Gtk.Button, when it has one)
+        # used to be accepted by _confirm_send_action but never threaded any
+        # further - every caller's busy-indicator intent was silently
+        # dropped here, and _send_action always got a hardcoded None instead.
+        # _send_action already has a real, working busy/spinner mechanism
+        # for a Gtk.Button (see its own body) that only clears once the
+        # underlying printer.gcode.script call genuinely completes - this
+        # just lets that reach the button again. Concrete motivating case:
+        # panels/temperature.py's "Calibrate PID" confirm dialog gave the
+        # user zero feedback for the multi-minute duration of a real
+        # PID_CALIBRATE run (repro'd live, 2026-08-15) - passing None here
+        # was the reason, not a missing feature elsewhere.
+        # Safe for every existing caller: _send_action's own
+        # `isinstance(widget, Gtk.Button)` check means anything that isn't a
+        # real Button (including the pre-existing None from every caller
+        # that doesn't have one) behaves exactly as before - fire-and-
+        # forget, no busy indicator, no exception.
         self.gtk.remove_dialog(dialog)
         if response_id == Gtk.ResponseType.OK:
-            self._send_action(None, method, params)
+            self._send_action(widget, method, params)
 
     def _send_action(self, widget, method, params):
         logging.info(f"{method}: {params}")
