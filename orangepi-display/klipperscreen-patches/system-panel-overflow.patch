+        self.cpu_flowbox.set_max_children_per_line(2)
         self.cpu_flowbox.get_style_context().add_class("monospaced")
 
         for i in range(self.cpu_count):
@@ -209,6 +233,26 @@ class Panel(ScreenPanel):
         self.populate_info()
 
         scroll = self._gtk.ScrolledWindow()
+        # 2026-07-31 overflow fix, THE decisive lever (found by live
+        # get_allocation() logging, since removed -- guessing at spacing
+        # constants first was not enough, see the two notes above). This is a
+        # CustomScrolledWindow (ks_includes/widgets/scroll.py) with
+        # `overlay_scrolling: False` by default, so its vertical scrollbar --
+        # base.css `scrollbar slider {min-width: 2.5em}` == ~35px at this
+        # theme's 14px font -- eats real layout width out of the ~284px
+        # content area (320px screen minus the ~36px sidebar), leaving the
+        # viewport only ~249px. This panel is long and always scrolls, so
+        # that scrollbar is ALWAYS present. Measured: self.grid's minimum
+        # width is 273px (the "Cores:" label column 97px + the core-percent
+        # FlowBox 166px + spacing), and GTK honours a widget's minimum over
+        # the space actually available, so the grid was allocated its full
+        # 273px and simply got clipped by the 249px viewport -- cutting the
+        # right-hand core column mid-glyph, exactly as reported. Overlay
+        # scrolling draws the scrollbar on top of the content instead of
+        # beside it, returning those ~35px to the viewport (284px > 273px, so
+        # the grid now fits with room to spare). Same fix, same reason, as
+        # main-menu-single-column.patch and the Temperature preset column.
+        scroll.set_overlay_scrolling(True)
         scroll.add(self.grid)
         self.content.add(scroll)
 
