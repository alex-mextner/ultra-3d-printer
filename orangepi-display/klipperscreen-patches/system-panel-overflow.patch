         self.cpu_flowbox.set_min_children_per_line(1)
+        # 2026-07-31 overflow fix (user report, live screenshot): with no
+        # max_children_per_line set, Gtk.FlowBox picked 3-per-line on this
+        # panel's ~150-160px column (column 0 -- "Cores:" -- and the sidebar
+        # eat most of the 320px screen), but 3 "  0%"-style labels plus two
