+    # ----------------------------------------------------------------------
+    # Smoke alarm banner (2026-08-02).
+    #
+    # The user asked for: a red full-screen banner whenever the smoke siren
+    # is sounding, on top of whatever is on screen, dismissed by ANY of the
+    # five buttons, and dismissing it silences the siren for 10 minutes.
+    # The names of the Klipper object and of the macro are the contract with
+    # the hardware half of the feature and live in the class constants at
+    # the top of this file.
+    #
+    # Design notes, all of them consequences of bugs already paid for in
+    # this codebase:
+    #
+    # * The banner is an OVERLAY CHILD, added on raise and removed on
+    #   dismiss. Not a panel: panels are torn down and rebuilt constantly
+    #   (a Klipper shutdown alone runs _remove_all_panels() plus a full
+    #   reinit), and the one moment the banner must survive is exactly the
+    #   moment the printer is in trouble. self.overlay outlives all of it.
+    #   Never merely hidden, because both attach_panel() (self.show_all())
+    #   and ScreenSaver.delayed_wake() (child.show() on every overlay child)
+    #   would put a hidden banner back on screen.
+    # * It contains NO focusable widget and never touches focus. Ten input
+    #   bugs in this session came from focus left pointing at a widget that
+    #   went away; the cheapest way not to add an eleventh is to leave the
+    #   focus chain exactly as it was and let the key branch swallow keys
+    #   while the banner is up.
+    # * Modal KlippyGtk.Dialog()s are separate toplevels: they would sit ON
+    #   TOP of the banner and eat the keys (see KlippyGtk.dialog_key_press).
+    #   So they are hidden on raise and restored on dismiss, the same way
+    #   ScreenSaver.show()/delayed_wake() already do it.
+    # * No mistouch/deaf window after raise, deliberately. A guard period
+    #   would mean a key press that visibly does nothing, which is the
+    #   exact failure mode this session spent ten bugs on -- and the user's
+    #   requirement is literally "any button closes it". The siren itself is
+    #   what draws attention; the banner only has to say why.
+    # ----------------------------------------------------------------------
+    @property
+    def _smoke_alarm_showing(self):
+        return self._smoke_alarm_banner is not None
+
+    def _smoke_alarm_value(self):
+        # None means "no such object / nothing usable" -> feature inert.
+        if self.printer is None:
+            return None
+        try:
+            value = self.printer.get_stat(self.SMOKE_ALARM_OBJECT).get(self.SMOKE_ALARM_FIELD)
+            return None if value is None else float(value)
+        except (TypeError, ValueError, AttributeError):
+            return None
+
+    def _smoke_klipper_is_down(self):
+        state = self.printer.get_stat("webhooks", "state") if self.printer else None
+        return state in ("shutdown", "error")
+
+    def _smoke_shutdown_active(self):
+        # "Klipper is down BECAUSE of smoke", as opposed to any other
+        # shutdown. The marker is remembered rather than re-tested every
+        # time because _status_update() drops every update once the state
+        # is shutdown -- the message may only ever be seen once, or arrive
+        # out of band from the printer.info query below.
+        if not self._smoke_klipper_is_down():
+            self._smoke_shutdown_marker = False
+            return False
+        message = self.printer.get_stat("webhooks", "state_message")
+        if self._smoke_marker_in(message):
+            self._smoke_shutdown_marker = True
+        return self._smoke_shutdown_marker
+
+    def _smoke_marker_in(self, message):
+        # Containment, NOT startswith. MEASURED live 2026-08-02 by running
+        # SMOKE_ALARM on this printer: Klipper's invoke_shutdown() does not
+        # use the macro's text verbatim, it wraps it --
+        #
+        #   "Shutdown due to SMOKE ALARM: MQ-2 triggered\nOnce the
+        #    underlying issue is corrected, use the \"FIRMWARE_RESTART\"
+        #    command to reset the firmware, reload the config, and restart
+        #    the host software."
+        #
+        # -- so a prefix test against "SMOKE ALARM" never matches and the
+        # banner would never appear in the one scenario it exists for.
+        # (printer-configs/smoke-alarm.cfg still documents it as a prefix;
+        # reported to the hardware half.)
+        return isinstance(message, str) and self.SMOKE_SHUTDOWN_MARKER in message
+
+    def _smoke_alarm_source(self):
+        # Which of the two sources says there is a fire, if any.
+        if self._smoke_shutdown_active():
+            return "shutdown"
+        value = self._smoke_alarm_value()
+        if value is not None and value > 0:
+            return "pin"
+        return None
+
+    def _smoke_alarm_update(self):
+        # Edge-triggered on purpose: raising on every update while the
+        # source is still hot would put the banner back a fraction of a
+        # second after the user dismissed it, forever. The latch is
+        # released when the source goes quiet, so a SECOND alarm after the
+        # snooze expires shows the banner again.
+        source = self._smoke_alarm_source()
+        if source is not None:
+            if not self._smoke_alarm_latched:
+                self._smoke_alarm_latched = True
+                self._smoke_alarm_raise(source)
+            return
+        if self._smoke_alarm_latched:
+            logging.info("Smoke alarm: source quiet again, re-arming")
+            self._smoke_alarm_latched = False
+        if self._smoke_alarm_showing:
+            # Silenced somewhere else (Mainsail, the macro's own timer, a
+            # console SET_PIN, a FIRMWARE_RESTART from the web UI): take
+            # the banner down without sending anything -- there is nothing
+            # left to silence.
+            logging.info("Smoke alarm: source cleared, hiding banner")
+            self._smoke_alarm_hide_banner()
+
+    @staticmethod
+    def _smoke_alarm_headline(source):
+        return "ПЕЧАТЬ ОСТАНОВЛЕНА" if source == "shutdown" else "СРАБОТАЛ ДАТЧИК ДЫМА"
+
+    def _smoke_alarm_on_shutdown(self):
+        # Klipper going down is the ONE transition the status-update hook
+        # cannot be trusted with: NotificationHandler._status_update()
+        # discards everything once printer.state == "shutdown", so if
+        # notify_klippy_shutdown wins the race against the status update
+        # carrying state_message, the marker never reaches
+        # _smoke_alarm_update() and the banner would never appear -- in the
+        # only scenario that actually matters. Re-evaluate here, where the
+        # state transition itself lands, and if state_message is not known
+        # yet ask Moonraker for it directly: one RPC, only on a shutdown,
+        # and printer.info answers during a shutdown (that is the point of
+        # the contract in printer-configs/smoke-alarm.cfg).
+        self._smoke_alarm_update()
+        if self._smoke_alarm_showing:
+            # Very common: SMOKE_ALARM's SET_PIN update wins the race
+            # against its own shutdown, so the banner is already up saying
+            # "СРАБОТАЛ ДАТЧИК ДЫМА" when the printer stops. Tell the user
+            # the more important fact now that it is true.
+            if self._smoke_shutdown_active() and self._smoke_alarm_text is not None:
+                self._smoke_alarm_text.set_label(self._smoke_alarm_headline("shutdown"))
+            return
+        message = self.printer.get_stat("webhooks", "state_message") if self.printer else None
+        if isinstance(message, str) and message.strip():
+            return  # message known, and it is not ours
+        try:
+            if self._ws is not None:
+                self._ws.api.get_printer_info(self._smoke_alarm_printer_info)
+        except Exception:
+            logging.exception("Smoke alarm: printer.info query failed")
+
+    def _smoke_alarm_printer_info(self, response, method, params, *args):
+        result = response.get("result") if isinstance(response, dict) else None
+        message = result.get("state_message", "") if isinstance(result, dict) else ""
+        if not self._smoke_marker_in(message):
+            return
+        logging.info("Smoke alarm: marker found in printer.info state_message")
+        self._smoke_shutdown_marker = True
+        self._smoke_alarm_update()
+
+    def _smoke_alarm_raise(self, source):
+        logging.info(f"Smoke alarm: RAISED (source={source})")
+        self.log_notification("SMOKE ALARM / ДЫМ", 2)
+        if self._smoke_alarm_showing:
+            return
+        self.close_popup_message()
+        for dialog in self.dialogs:
+            logging.info("Smoke alarm: hiding dialog")
+            dialog.hide()
+        # The screen is very likely blanked: this fires unattended, at
+        # night, on a machine whose backlight goes off after a few minutes.
+        # wake_screen() drives DPMS (no-op when use_dpms is off) and
+        # screensaver.close() takes the black overlay away. ScreenSaver.show()
+        # additionally refuses to blank while the banner is up, so it cannot
+        # come back over it a minute later.
+        self.wake_screen()
+        self.screensaver.close()
+        self._smoke_alarm_banner = self._smoke_alarm_build_banner(source)
+        self.overlay.add_overlay(self._smoke_alarm_banner)
+        self._smoke_alarm_banner.show_all()
+
+    def _smoke_alarm_build_banner(self, source="pin"):
+        # Sized to the whole screen explicitly, like ScreenSaver's box: an
+        # overlay child that only asks for its natural size leaves the panel
+        # underneath visible around it.
+        box = Gtk.Box(
+            orientation=Gtk.Orientation.VERTICAL,
+            halign=Gtk.Align.FILL,
+            valign=Gtk.Align.FILL,
+            width_request=self.width,
+            height_request=self.height,
+        )
+        box.get_style_context().add_class("smoke_alarm")
+        title = Gtk.Label(label="ДЫМ!", hexpand=True, vexpand=True)
+        title.get_style_context().add_class("smoke_alarm_title")
+        # Line lengths are not free-form: MEASURED on this 320px panel, the
+        # middle line fits ~21 characters at its size and the hint ~38.
+        #
+        # The hint is the SAME in both cases on purpose. It describes what
+        # the user gets, not the mechanism -- and it stays true either way,
+        # because FIRMWARE_RESTART also brings the pin back to value: 0 and
+        # restarts the config's 600-second disarm window. Saying "рестарт
+        # прошивки" would be both scarier and less accurate about the
+        # outcome; and since the pin update often wins the race against the
+        # shutdown, the same real fire can raise the banner from either
+        # source, so the two wordings would be a coin toss.
+        self._smoke_alarm_text = text = Gtk.Label(
+            label=self._smoke_alarm_headline(source),
+            hexpand=True,
+        )
+        text.get_style_context().add_class("smoke_alarm_text")
+        hint = Gtk.Label(
+            label="Любая кнопка — тишина 10 мин",
+            hexpand=True,
+            wrap=True,
+            wrap_mode=Pango.WrapMode.WORD_CHAR,
+        )
+        hint.get_style_context().add_class("smoke_alarm_hint")
+        for label in (title, text, hint):
+            label.set_can_focus(False)
+            box.add(label)
+        return box
+
+    def _smoke_alarm_hide_banner(self):
+        banner = self._smoke_alarm_banner
+        if banner is None:
+            return
+        self._smoke_alarm_banner = None
+        self._smoke_alarm_text = None
+        try:
+            self.overlay.remove(banner)
+            banner.destroy()
+        except Exception:
+            logging.exception("Smoke alarm: removing the banner failed")
+        for dialog in self.dialogs:
+            logging.info("Smoke alarm: restoring dialog")
+            dialog.show()
+        # Blanking was suppressed while the banner was up (see
+        # ScreenSaver.show()); start the countdown again from now.
+        self.screensaver.reset_timeout()
+
+    def _smoke_alarm_macro_missing(self):
+        # MEASURED 2026-08-02 on this printer: Klipper answers
+        # printer.gcode.script for an unknown command with
+        # {"result": "ok"} plus a plain "// Unknown command:..." console
+        # line -- NOT a JSON-RPC error. So the response callback below
+        # cannot tell a correct macro name from a wrong one, and the only
+        # reliable check is the config Klipper already published to us.
+        # This is the contract-drift alarm: if the hardware half ships the
+        # macro under a different name, the user finds out the first time
+        # they dismiss the banner instead of silently not snoozing.
+        config = getattr(self.printer, "config", None) if self.printer else None
+        if not config:
+            # Config not known (early startup) -- do not accuse, just send.
+            return False
+        wanted = f"gcode_macro {self.SMOKE_SILENCE_MACRO}".lower()
+        return all(section.lower() != wanted for section in config)
+
+    def _smoke_alarm_dismiss(self):
+        # The silencing action is decided HERE, from the live state, not
+        # from whatever raised the banner. SMOKE_ALARM sets the pin and
+        # then shuts Klipper down milliseconds later, so a banner raised by
+        # the pin is very often dismissed with Klipper already down -- and
+        # then g-code is refused outright (klippy/gcode.py allows only
+        # M110/M112/M115/RESTART/FIRMWARE_RESTART/ECHO/STATUS/HELP after a
+        # shutdown), so a macro here would be a guaranteed no-op.
+        down = self._smoke_klipper_is_down()
+        self._smoke_alarm_hide_banner()
+        if down:
+            # FIRMWARE_RESTART is what ends the alarm: it brings the pin
+            # back to its configured value: 0 (silence) and restarts the
+            # config's `initial_duration: 600` disarm window, which IS the
+            # user's "ten minutes". Nothing else to call -- the snooze is
+            # automatic on the Klipper side.
+            self._smoke_alarm_send(
+                "printer.firmware_restart", {}, "FIRMWARE_RESTART", "Нужен FIRMWARE_RESTART"
+            )
+            return
+        if self._smoke_alarm_macro_missing():
+            self._smoke_alarm_silence_failed(f"нет {self.SMOKE_SILENCE_MACRO}")
+            return
+        self._smoke_alarm_send(
+            "printer.gcode.script",
+            {"script": self.SMOKE_SILENCE_MACRO},
+            self.SMOKE_SILENCE_MACRO,
+        )
+
+    def _smoke_alarm_send(self, method, params, label, hint="Выключите её вручную!"):
+        sent = False
+        try:
+            if self._ws is not None:
+                sent = self._ws.send_method(
+                    method, params, self._smoke_alarm_rpc_result, label, hint
+                )
+        except Exception:
+            logging.exception(f"Smoke alarm: sending {label} raised")
+            sent = False
+        if sent:
+            logging.info(f"Smoke alarm: dismissed, sent {label}")
+        else:
+            # send_method() returns False when the websocket is down.
+            self._smoke_alarm_silence_failed("нет связи с Moonraker", hint)
+
+    def _smoke_alarm_rpc_result(self, response, method, params, *args):
+        # Moonraker answers every JSON-RPC call; an unknown macro, or a
+        # Klipper that is shut down after an M112, comes back as "error".
+        # That is the whole point of passing a callback: the banner is
+        # already gone by then (it must be -- a screen that cannot be
+        # dismissed during a fire is the worst possible failure), so this
+        # is the only thing left that can tell the user the siren is still
+        # live.
+        label = args[0] if args else "?"
+        hint = args[1] if len(args) > 1 else "Выключите её вручную!"
+        error = response.get("error") if isinstance(response, dict) else None
+        if error:
+            message = error.get("message", error) if isinstance(error, dict) else error
+            self._smoke_alarm_silence_failed(str(message), hint)
+            return
+        logging.info(f"Smoke alarm: {label} accepted")
+
+    def _smoke_alarm_silence_failed(self, reason, hint="Выключите её вручную!"):
+        logging.error(f"Smoke alarm: silencing FAILED: {reason}")
+        # level 2 = warning: stays on screen for 300s instead of 10, and
+        # lands in the notification log behind the bell, so the message
+        # survives being missed. Deliberately NOT re-raising the banner:
+        # with the pin still high that would loop banner -> key -> failure
+        # -> banner and lock the user out of the very UI they need to
+        # recover Klipper (FIRMWARE_RESTART lives behind that UI).
+        #
+        # Three short lines rather than one sentence: MEASURED live on this
+        # 320px screen, show_popup_message()'s popover clips at roughly 28
+        # characters per line (its label wraps at max_width_chars=40, which
+        # is already wider than the popover), so a long single line loses
+        # its beginning AND its end.
+        reason = str(reason).strip().replace("\n", " ")[:56]
+        self.show_popup_message(f"Сирена НЕ выключена:\n{reason}\n{hint}", 2)
+
