+    # ----------------------------------------------------------------------
+    # Smoke alarm banner (2026-08-02).
+    #
+    # The user asked for: a red full-screen banner whenever the smoke siren
+    # is sounding, on top of whatever is on screen, dismissed by ANY of the
+    # five buttons, and dismissing it silences the siren for 10 minutes.
+    # The names of the Klipper object and of the macro are the contract with
+    # the hardware half of the feature and live in the class constants at
+    # the top of this file.
+    #
+    # Design notes, all of them consequences of bugs already paid for in
+    # this codebase:
+    #
+    # * The banner is an OVERLAY CHILD, added on raise and removed on
+    #   dismiss. Not a panel: panels are torn down and rebuilt constantly
+    #   (a Klipper shutdown alone runs _remove_all_panels() plus a full
+    #   reinit), and the one moment the banner must survive is exactly the
+    #   moment the printer is in trouble. self.overlay outlives all of it.
+    #   Never merely hidden, because both attach_panel() (self.show_all())
+    #   and ScreenSaver.delayed_wake() (child.show() on every overlay child)
+    #   would put a hidden banner back on screen.
+    # * It contains NO focusable widget and never touches focus. Ten input
+    #   bugs in this session came from focus left pointing at a widget that
+    #   went away; the cheapest way not to add an eleventh is to leave the
+    #   focus chain exactly as it was and let the key branch swallow keys
+    #   while the banner is up.
+    # * Modal KlippyGtk.Dialog()s are separate toplevels: they would sit ON
+    #   TOP of the banner and eat the keys (see KlippyGtk.dialog_key_press).
+    #   So they are hidden on raise and restored on dismiss, the same way
+    #   ScreenSaver.show()/delayed_wake() already do it.
+    # * No mistouch/deaf window after raise, deliberately. A guard period
+    #   would mean a key press that visibly does nothing, which is the
+    #   exact failure mode this session spent ten bugs on -- and the user's
+    #   requirement is literally "any button closes it". The siren itself is
+    #   what draws attention; the banner only has to say why.
+    # ----------------------------------------------------------------------
+    @property
+    def _smoke_alarm_showing(self):
+        return self._smoke_alarm_banner is not None
+
+    def _smoke_alarm_value(self):
+        # None means "no such object / nothing usable" -> feature inert.
+        if self.printer is None:
+            return None
+        try:
+            value = self.printer.get_stat(self.SMOKE_ALARM_OBJECT).get(self.SMOKE_ALARM_FIELD)
+            return None if value is None else float(value)
+        except (TypeError, ValueError, AttributeError):
+            return None
+
+    def _smoke_alarm_update(self):
+        # Called on every notify_status_update. Edge-triggered on purpose:
+        # raising on every update while the pin stays high would put the
+        # banner back a fraction of a second after the user dismissed it,
+        # forever. The latch is released when the pin returns to 0, so a
+        # SECOND alarm after the snooze expires shows the banner again.
+        value = self._smoke_alarm_value()
+        if value is None:
+            return
+        if value > 0:
+            if not self._smoke_alarm_latched:
+                self._smoke_alarm_latched = True
+                self._smoke_alarm_raise(value)
+            return
+        if self._smoke_alarm_latched:
+            logging.info(f"Smoke alarm: {self.SMOKE_ALARM_OBJECT} back to 0, re-arming")
+            self._smoke_alarm_latched = False
+        if self._smoke_alarm_showing:
+            # Silenced somewhere else (Mainsail, the macro's own timer, a
+            # console SET_PIN): take the banner down without sending
+            # anything -- there is nothing left to snooze.
+            logging.info("Smoke alarm: source cleared, hiding banner")
+            self._smoke_alarm_hide_banner()
+
+    def _smoke_alarm_raise(self, value):
+        logging.info(f"Smoke alarm: RAISED ({self.SMOKE_ALARM_OBJECT} = {value})")
+        self.log_notification("SMOKE ALARM / ДЫМ", 2)
+        if self._smoke_alarm_showing:
+            return
+        self.close_popup_message()
+        for dialog in self.dialogs:
+            logging.info("Smoke alarm: hiding dialog")
+            dialog.hide()
+        # The screen is very likely blanked: this fires unattended, at
+        # night, on a machine whose backlight goes off after a few minutes.
+        # wake_screen() drives DPMS (no-op when use_dpms is off) and
+        # screensaver.close() takes the black overlay away. ScreenSaver.show()
+        # additionally refuses to blank while the banner is up, so it cannot
+        # come back over it a minute later.
+        self.wake_screen()
+        self.screensaver.close()
+        self._smoke_alarm_banner = self._smoke_alarm_build_banner()
+        self.overlay.add_overlay(self._smoke_alarm_banner)
+        self._smoke_alarm_banner.show_all()
+
+    def _smoke_alarm_build_banner(self):
+        # Sized to the whole screen explicitly, like ScreenSaver's box: an
+        # overlay child that only asks for its natural size leaves the panel
+        # underneath visible around it.
+        box = Gtk.Box(
+            orientation=Gtk.Orientation.VERTICAL,
+            halign=Gtk.Align.FILL,
+            valign=Gtk.Align.FILL,
+            width_request=self.width,
+            height_request=self.height,
+        )
+        box.get_style_context().add_class("smoke_alarm")
+        title = Gtk.Label(label="ДЫМ!", hexpand=True, vexpand=True)
+        title.get_style_context().add_class("smoke_alarm_title")
+        text = Gtk.Label(label="СРАБОТАЛ ДАТЧИК ДЫМА", hexpand=True)
+        text.get_style_context().add_class("smoke_alarm_text")
+        hint = Gtk.Label(
+            label="Любая кнопка — тишина 10 мин",
+            hexpand=True,
+            wrap=True,
+            wrap_mode=Pango.WrapMode.WORD_CHAR,
+        )
+        hint.get_style_context().add_class("smoke_alarm_hint")
+        for label in (title, text, hint):
+            label.set_can_focus(False)
+            box.add(label)
+        return box
+
+    def _smoke_alarm_hide_banner(self):
+        banner = self._smoke_alarm_banner
+        if banner is None:
+            return
+        self._smoke_alarm_banner = None
+        try:
+            self.overlay.remove(banner)
+            banner.destroy()
+        except Exception:
+            logging.exception("Smoke alarm: removing the banner failed")
+        for dialog in self.dialogs:
+            logging.info("Smoke alarm: restoring dialog")
+            dialog.show()
+        # Blanking was suppressed while the banner was up (see
+        # ScreenSaver.show()); start the countdown again from now.
+        self.screensaver.reset_timeout()
+
+    def _smoke_alarm_macro_missing(self):
+        # MEASURED 2026-08-02 on this printer: Klipper answers
+        # printer.gcode.script for an unknown command with
+        # {"result": "ok"} plus a plain "// Unknown command:..." console
+        # line -- NOT a JSON-RPC error. So the response callback below
+        # cannot tell a correct macro name from a wrong one, and the only
+        # reliable check is the config Klipper already published to us.
+        # This is the contract-drift alarm: if the hardware half ships the
+        # macro under a different name, the user finds out the first time
+        # they dismiss the banner instead of silently not snoozing.
+        config = getattr(self.printer, "config", None) if self.printer else None
+        if not config:
+            # Config not known (early startup) -- do not accuse, just send.
+            return False
+        wanted = f"gcode_macro {self.SMOKE_SNOOZE_MACRO}".lower()
+        return all(section.lower() != wanted for section in config)
+
+    def _smoke_alarm_dismiss(self):
+        self._smoke_alarm_hide_banner()
+        if self._smoke_alarm_macro_missing():
+            self._smoke_alarm_snooze_failed(f"нет макроса {self.SMOKE_SNOOZE_MACRO}")
+            return
+        sent = False
+        try:
+            if self._ws is not None:
+                sent = self._ws.api.gcode_script(
+                    self.SMOKE_SNOOZE_MACRO, self._smoke_alarm_snooze_result
+                )
+        except Exception:
+            logging.exception(f"Smoke alarm: sending {self.SMOKE_SNOOZE_MACRO} raised")
+            sent = False
+        if sent:
+            logging.info(f"Smoke alarm: dismissed, sent {self.SMOKE_SNOOZE_MACRO}")
+        else:
+            # send_method() returns False when the websocket is down.
+            self._smoke_alarm_snooze_failed("нет связи с Moonraker")
+
+    def _smoke_alarm_snooze_result(self, response, method, params, *args):
+        # Moonraker answers every JSON-RPC call; an unknown macro, or a
+        # Klipper that is shut down after an M112, comes back as "error".
+        # That is the whole point of passing a callback: the banner is
+        # already gone by then (it must be -- a screen that cannot be
+        # dismissed during a fire is the worst possible failure), so this
+        # is the only thing left that can tell the user the siren is still
+        # live.
+        error = response.get("error") if isinstance(response, dict) else None
+        if error:
+            message = error.get("message", error) if isinstance(error, dict) else error
+            self._smoke_alarm_snooze_failed(str(message))
+            return
+        logging.info(f"Smoke alarm: {self.SMOKE_SNOOZE_MACRO} accepted by Klipper")
+
+    def _smoke_alarm_snooze_failed(self, reason):
+        logging.error(f"Smoke alarm: {self.SMOKE_SNOOZE_MACRO} FAILED: {reason}")
+        # level 2 = warning: stays on screen for 300s instead of 10, and
+        # lands in the notification log behind the bell, so the message
+        # survives being missed. Deliberately NOT re-raising the banner:
+        # with the pin still high that would loop banner -> key -> failure
+        # -> banner and lock the user out of the very UI they need to
+        # recover Klipper (FIRMWARE_RESTART lives behind that UI).
+        #
+        # Three short lines rather than one sentence: MEASURED live on this
+        # 320px screen, show_popup_message()'s popover clips at roughly 28
+        # characters per line (its label wraps at max_width_chars=40, which
+        # is already wider than the popover), so a long single line loses
+        # its beginning AND its end.
+        reason = str(reason).strip().replace("\n", " ")[:56]
+        self.show_popup_message(f"Сирена НЕ выключена:\n{reason}\nВыключите её вручную!", 2)
+
