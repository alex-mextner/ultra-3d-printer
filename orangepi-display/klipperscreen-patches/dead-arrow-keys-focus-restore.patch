+    def _can_take_focus(self, widget):
+        # True only if Gtk.Window.set_focus(widget) would really move focus
+        # there. Mirrors gtk_widget_grab_focus()'s own preconditions: it is
+        # a SILENT no-op on an insensitive or non-focusable widget, and on
+        # one whose toplevel is no longer this window (unparented with a
+        # Python reference still holding it alive). Checking these up front
+        # is what lets the caller avoid claiming a key it did not use.
+        if widget is None:
+            return False
+        try:
+            return bool(
+                widget.get_mapped()
+                and widget.is_sensitive()
+                and widget.get_can_focus()
+                and widget.get_toplevel() is self
+            )
+        except Exception:
+            return False
+
+    def _focus_into_current_panel(self, keyval_name="Down"):
+        # Put focus somewhere sensible inside the visible panel body, and
+        # report whether it landed. Used when there is no focus and nothing
+        # valid to restore -- most importantly right after the on-screen
+        # Back button was activated, which makes that very button
+        # insensitive and so leaves focus at None with the user staring at
+        # a fresh panel. Aiming explicitly at base_panel.content keeps the
+        # press inside the panel actually on screen, instead of GTK's
+        # from-nothing fallback which sends Down to the sidebar bell.
+        content = getattr(self.base_panel, "content", None)
+        if content is None:
+            return False
+        pressed = {
+            "Up": Gtk.DirectionType.UP,
+            "Down": Gtk.DirectionType.DOWN,
+            "Left": Gtk.DirectionType.LEFT,
+            "Right": Gtk.DirectionType.RIGHT,
+        }.get(keyval_name, Gtk.DirectionType.DOWN)
+        # TAB_FORWARD as the fallback: a purely directional child_focus()
+        # can decline to enter a container at all depending on geometry,
+        # whereas tab order always has a first focusable element if one
+        # exists anywhere in the panel.
+        for direction in (pressed, Gtk.DirectionType.TAB_FORWARD):
+            try:
+                if content.child_focus(direction) and self.get_focus() is not None:
+                    return True
+            except Exception:
+                logging.exception("Focusing into the current panel failed")
+                return False
+        return False
+
+    def _describe_focus(self, widget):
+        # Short, log-safe identity of a focus target: type, its label, and
+        # the four properties that decide whether it can actually TAKE
+        # focus. mapped/sensitive/can-focus matter because
+        # gtk_widget_grab_focus() is a silent no-op when any of them is
+        # false -- so a set_focus() call can appear to succeed while focus
+        # stays exactly where it was. "detached" (toplevel is not this
+        # window) catches a widget that has been unparented out of the
+        # tree. Never raises: this only ever runs to build a log line, and
+        # a broken log line must not break input handling.
+        if widget is None:
+            return "None"
+        try:
+            name = type(widget).__name__
+            label = ""
+            if isinstance(widget, Gtk.Button):
+                label = widget.get_label() or ""
+            if not label:
+                try:
+                    label = widget.get_tooltip_text() or ""
+                except Exception:
+                    label = ""
+            label = str(label).strip().replace("\n", " ")[:24]
+            flags = ""
+            try:
+                if not widget.get_mapped():
+                    flags += " UNMAPPED"
+                if not widget.is_sensitive():
+                    flags += " INSENSITIVE"
+                if not widget.get_can_focus():
+                    flags += " NO-CAN-FOCUS"
+                if widget.get_toplevel() is not self:
+                    flags += " DETACHED"
+            except Exception:
+                pass
+            return f"{name}{'(' + label + ')' if label else ''}{flags}"
+        except Exception as exc:
+            return f"<undescribable {exc}>"
+
