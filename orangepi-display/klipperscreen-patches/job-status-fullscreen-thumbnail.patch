+        row = Gtk.Box(spacing=4)
+        cap = Gtk.Label(label=caption, xalign=0.0, ellipsize=Pango.EllipsizeMode.END)
+        cap.get_style_context().add_class("js-caption")
+        val = Gtk.Label(label="-", xalign=1.0, hexpand=True, ellipsize=Pango.EllipsizeMode.END)
+        val.get_style_context().add_class("js-value")
+        row.pack_start(cap, False, False, 0)
+        row.pack_start(val, True, True, 0)
+        button.add(row)
+        if on_click is not None:
+            button.connect("clicked", *on_click)
+        button.connect("clicked", self._screen.screensaver.reset_timeout)
+        button.connect("clicked", self._screen.lock_screen.reset_timeout)
+        self.buttons[key] = button
+        self.readout_values[button] = val
+        return button
