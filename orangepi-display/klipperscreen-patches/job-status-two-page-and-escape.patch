+        self.labels["big_thumbnail"].set_size_request(self.thumb_size + 14, -1)
+        self.labels["big_thumbnail"].connect("clicked", self.show_fullscreen_thumbnail)
+
+        # Readouts. Nozzle/bed keep the same click target as on the detailed
+        # page (the temperature panel); layer and time open the detailed page
