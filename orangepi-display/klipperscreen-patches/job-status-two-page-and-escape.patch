+    def on_draw_bar(self, da, ctx):
+        w = da.get_allocated_width()
+        h = da.get_allocated_height()
+        ctx.set_source_rgb(0.13, 0.13, 0.13)
+        ctx.rectangle(0, 0, w, h)
+        ctx.fill()
+        # Same red as the progress ring on the detailed page (on_draw).
+        ctx.set_source_rgb(0.718, 0.110, 0.110)
+        ctx.rectangle(0, 0, w * min(max(self.progress, 0), 1), h)
+        ctx.fill()
