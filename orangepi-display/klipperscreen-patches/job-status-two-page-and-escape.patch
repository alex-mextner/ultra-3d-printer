+    def back(self):
+        # 2026-08-17 -- THE ESCAPE HATCH. Bug report, verbatim: "кажется в
+        # некоторых режимах из него невозможно выйти. я даже сделал экстренный
+        # стоп просто чтобы перезагрузить экран". Confirmed from the device's
+        # own KlipperScreen.log, 11:31:57 - 11:32:19: four BackSpace presses,
+        # each logged as "#### Menu go back", each doing nothing, then
+        # `MoonrakerApi.emergency_stop`. He had to kill the printer to get off
+        # this screen. Mechanism: state_printing() opens this panel with
+        # remove_all=True, so _cur_panels == ["job_status"] and _menu_go_back()
+        # takes its len<=1 branch, which only re-seats focus; and while a job
+        # is running show_buttons_for_state() offers Pause/Cancel/Fine Tuning/
+        # Settings -- no Main Menu, can_close False. So on a 5-button pad with
+        # no touchscreen there was literally no exit but the estop, and the
+        # only other one he found was to CANCEL THE PRINT (log 11:40:43).
+        #
+        # base_panel.back() consults this method for both the physical back
+        # button (BackSpace) and the action-bar arrow, and falls through to
+        # _menu_go_back() when it returns False -- so implementing it here
+        # fixes both inputs without touching screen.py. It never returns False:
+        # every view of this panel now leads somewhere.
+        if self.stack.get_visible_child_name() == "detailed":
+            if self.current_info is not self.status_grid:
+                # deepest level: a move/time/extrusion table -> its overview
+                self.switch_info(info=self.status_grid)
+                return True
+            self.show_minimal()
+            return True
+        if self.can_close:
+            self.close_panel()
+            return True
+        # Printing, paused or cancelling: the job owns the screen and closing
+        # the panel outright would leave no way back to it. Same destination as
+        # the panel's own "Menu" button instead - the __print menu, pushed ON
+        # TOP of this panel, so it has a real way back (this panel becomes the
+        # parent) and it is where Temperature/Fan/Extrude/Console/Settings live
+        # during a print.
+        self.open_menu()
+        return True
