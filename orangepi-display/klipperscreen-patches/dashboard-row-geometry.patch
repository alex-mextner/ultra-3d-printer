--- a/styles/base.css
+++ b/styles/base.css
@@ -294,8 +294,46 @@
     min-height: 1em;
 }
 
+/* Narrow scrollbars (2026-07-31, agent-B scrollbar pass) -- MEASURED, not
+ * guessed. A non-overlay GTK3 scrollbar adds its own minimum width to the
+ * ScrolledWindow's minimum width even while the bar is invisible. Live
+ * DBG_WIDTH dump on the main dashboard: vscrollbar min = 35px (this 2.5em at
+ * the big-font themes' 14px font), which inflated the device-list panel's
+ * minimum from 75px to 108px. Because KlippyGtk.Button() creates BOTH the
+ * row's icon button and its value button with hexpand=True, Gtk.Grid then
+ * handed those 33 surplus px out as extra COLUMN width -- +18px to the icon
+ * column (47px allocated for a 29px need) and +16px to the value column (56px
+ * for a 37px need) -- so the reserve produced BOTH dead gaps on every
+ * temperature row (icon->value AND value->graph), not just the right-hand
+ * one. ks_includes/widgets/scroll.py now defaults to overlay scrolling, which
+ * removes the reserve entirely; .5em (7px) additionally keeps the bar itself
+ * thin wherever a scrolled window still ends up in non-overlay mode, which is
+ * also what the user asked for directly ("сильно уже"). */
 scrollbar slider {
-    min-width: 2.5em;
+    min-width: .5em;
+    border-radius: .7em;
+    background-color: @active;
+}
+
+/* Overlay scrollbars are drawn on top of the content (no layout width) but
+ * GTK3 fades them out ~1s after scrolling stops, so at rest there would be no
+ * hint that a list continues. GTK3 puts a resting overlay bar in the
+ * `.overlay-indicator` state and adds `.hovering`/`.dragging` when active;
+ * this keeps the resting indicator opaque and gives it a usable (but still
+ * thin) slider instead of Adwaita's 3px hairline. NOTE: GTK3 also calls
+ * gtk_widget_set_opacity()/gtk_widget_hide() on the scrollbar itself during
+ * the fade, which CSS cannot override -- so this rule only improves the bar
+ * WHILE it is shown; the persistent at-rest cue is the undershoot rule
+ * further down. */
+scrollbar.overlay-indicator:not(.dragging):not(.hovering) {
+    opacity: 1;
+    background-color: transparent;
+}
+
+scrollbar.overlay-indicator:not(.dragging):not(.hovering) slider {
+    min-width: .5em;
+    margin: 0;
+    border: none;
     border-radius: .7em;
     background-color: @active;
 }
@@ -313,9 +351,28 @@
     -gtk-icon-source: -gtk-icontheme("pan-up-symbolic");
 }
 
-undershoot.top,
+/* undershoot.* is GTK3's "there is more content past this edge" shading. It
+ * is drawn only while the view is actually scrolled away from that edge, it
+ * costs zero layout width, and it does NOT fade out -- which makes it the
+ * only persistent affordance left now that scrollbars are overlay-mode and
+ * auto-hide (see the .overlay-indicator note above). Upstream KlipperScreen
+ * blanks it (background-image: none); restored here as a thin 2px accent
+ * line, drawn with a 2-stop same-colour gradient + background-size (the same
+ * mechanism Adwaita itself uses for its dashed default, so it is guaranteed
+ * supported by GTK3's CSS engine) rather than Adwaita's dashes, which are
+ * too faint to read on a 320x240 panel. */
+undershoot.top {
+    background-image: linear-gradient(to bottom, @active, @active);
+    background-size: 100% 2px;
+    background-repeat: no-repeat;
+    background-position: center top;
+}
+
 undershoot.bottom {
-    background-image: none;
+    background-image: linear-gradient(to top, @active, @active);
+    background-size: 100% 2px;
+    background-repeat: no-repeat;
+    background-position: center bottom;
 }
 
 spinner {
@@ -475,8 +532,15 @@
     min-height: 350px;
 }
 
