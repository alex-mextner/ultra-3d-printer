+    def range_captured(self, widget):
+        """Is this exact slider currently held in D-pad editing mode?
+
+        The keyboard counterpart of Gtk.Widget.has_grab(), and the reason it
+        has to exist: has_grab() answers only for a POINTER grab, i.e. "a
+        mouse button is down on this widget". Every panel that owns a slider
+        guards its status-update path with has_grab() so that an incoming
+        notify_status_update cannot yank the handle out from under a finger
+        -- but on this machine there is no finger, the edit is a keyboard
+        capture (_capture_range), and that guard saw nothing.
+
+        Reproduced live 2026-08-01 on Limits before this existed: slider
+        captured at 175, arrowed to 129, then SET_VELOCITY_LIMIT VELOCITY=175
+        sent from Moonraker -- limits.update_option() ran, set_value() landed
+        on the captured widget, and the screen showed 175 with the capture
+        still active and no indication the edit had been discarded.
+
+        Panels call ScreenPanel.range_is_busy(), which ORs this with
+        has_grab(); this method is what makes the private capture state
+        askable from outside.
+        """
+        return self._captured_range is not None and self._captured_range is widget
+
     def _forget_range_capture(self):
         # Drop the capture state without sending or restoring anything.
         widget = self._captured_range
