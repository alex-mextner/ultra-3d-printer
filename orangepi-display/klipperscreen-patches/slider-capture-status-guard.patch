+    def range_is_busy(self, scale):
+        """True while the user is actively editing this slider -- do not set_value() on it.
+
+        2026-08-01. Upstream guards every slider's status-update path with
+        `scale.has_grab()`, which covers exactly one way of editing: a mouse
+        button held down on the handle. This machine has no mouse and no
+        touch; sliders are edited with the D-pad capture added the same day
+        (Enter captures, arrows move, Enter applies), which takes no pointer
+        grab at all -- so on this machine that guard was answering a question
+        nobody was asking, and an incoming notify_status_update overwrote the
+        value being edited. Reproduced live on Limits, see
+        KlipperScreen.range_captured() for the measurement.
+
+        One helper on the base class instead of six copies of the same `or`:
+        every panel that owns a Gtk.Scale inherits it, and a future third way
+        of holding a slider only has to be taught here.
+        """
+        return scale.has_grab() or self._screen.range_captured(scale)
+
