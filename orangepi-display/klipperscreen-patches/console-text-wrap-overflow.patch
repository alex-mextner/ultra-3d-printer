diff --git a/panels/console.py b/panels/console.py
index 7101a53..81b0bf6 100644
--- a/panels/console.py
+++ b/panels/console.py
@@ -43,9 +43,27 @@ class Panel(ScreenPanel):
         options.attach(o2_button, 1, 0, 1, 1)
 
         sw = Gtk.ScrolledWindow(hexpand=True, vexpand=True)
+        # 2026-07-31 overflow fix (user report, live screenshot): Gtk.TextView
+        # defaults to Gtk.WrapMode.NONE, so any gcode response/echo line wider
+        # than the 320px screen (e.g. "Must home axis first: 25.000000...")
+        # just ran off the right edge with no way to read the rest -- the
+        # ScrolledWindow's horizontal scrollbar defaults to overlay mode on
+        # this theme (see main-menu-single-column.patch's
+        # set_overlay_scrolling(True) discussion) and auto-hides, and there is
+        # no touchscreen/mouse on this kiosk to hover-then-drag it into view,
+        # so the clipped tail was permanently unreachable, not just visually
+        # tight. WORD_CHAR wraps normally on word boundaries but still breaks
+        # a single unbroken run of characters if needed (long numbers/paths),
+        # matching the same mode already used for Notifications
+        # (hanging-indent-notifications.patch). NEVER on the horizontal
+        # scrollbar policy removes the now-pointless empty affordance and
+        # guarantees wrapping is what actually happens instead of a
+        # zero-height scroll range some GTK versions could substitute.
+        sw.set_policy(Gtk.PolicyType.NEVER, Gtk.PolicyType.AUTOMATIC)
 
         tb = Gtk.TextBuffer()
         tv = Gtk.TextView(buffer=tb, editable=False, cursor_visible=False)
+        tv.set_wrap_mode(Gtk.WrapMode.WORD_CHAR)
         tv.connect("size-allocate", self._autoscroll)
         tv.connect("touch-event", self._screen.remove_keyboard)
         tv.connect("button-press-event", self._screen.remove_keyboard)
