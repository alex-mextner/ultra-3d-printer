+    def _capture_range(self, widget):
+        """Enter D-pad editing mode on a focused slider.
+
+        2026-08-01. Until now a Gtk.Scale on this machine was decoration: a
+        five-button D-pad could neither change its value nor transmit one.
+        Both halves were measured live on panels/fan.py, and BOTH were
+        broken -- the second one is the half the queue item did not know
+        about:
+
+          Key Right: focus Scale -> Button(Max) | via escape-range-focus
+          Key Up:    focus Scale -> Scale | via gtk-default(scrollable
+                     already at top, value=0/29)
+          Key Down:  focus Scale -> Scale | via dpad-scroll/adjustment
+                     0->29 of 29
+
+        Right/Left never reach the slider (they are how focus escapes it,
+        and they must stay that way -- Stop and Max sit either side of the
+        fan slider and are otherwise unreachable). Up DOES reach the
+        slider, but GTK maps STEP_UP on a range to *decrease*, so from 0 it
+        just clamped. Down was eaten by _dpad_scroll before the slider saw
+        it. Net result: the fan slider could not be raised by even one step,
+        so "commit the value on a keyboard event" alone would have fixed
+        nothing.
+
+        The fix is an explicit editing mode rather than a global re-mapping
+        of the arrows, for two reasons. It keeps every panel's navigation
+        exactly as the 2026-08-01 panel sweep verified it (re-purposing
+        Up/Down for all ranges would have changed navigation on Limits and
+        Pressure Advance, the panels that sweep certified), and it gives
+        the commit a natural moment: one command when the user applies,
+        instead of one per arrow press. Enter was free -- Gtk.Range binds
+        no activate action and nothing else here looked at Return.
+
+        Contract: Enter captures, arrows adjust, Enter applies, Back/Escape
+        cancels and restores the entry value. The slider turns amber
+        (.slider_captured in base.css) for as long as it is captured.
+        """
+        self._captured_range = widget
+        self._captured_range_entry_value = widget.get_value()
+        try:
+            widget.get_style_context().add_class("slider_captured")
+        except Exception:
+            logging.exception("Could not mark slider as captured")
+        logging.info(
+            f"Slider captured at {self._captured_range_entry_value:g}, "
+            f"d-pad step {self._range_step(widget):g}"
+        )
+
+    def _forget_range_capture(self):
+        # Drop the capture state without sending or restoring anything.
+        widget = self._captured_range
+        self._captured_range = None
+        self._captured_range_entry_value = None
+        if widget is not None:
+            try:
+                widget.get_style_context().remove_class("slider_captured")
+            except Exception:
+                pass
+        return widget
+
+    def _release_range(self, commit):
+        widget = self._captured_range
+        entry_value = self._captured_range_entry_value
+        self._forget_range_capture()
+        if widget is None:
+            return
+        try:
+            value = widget.get_value()
+        except Exception:
+            logging.exception("Releasing slider capture failed")
+            return
+        if not commit:
+            if value != entry_value:
+                widget.set_value(entry_value)
+            logging.info(f"Slider capture cancelled: {value:g} restored to {entry_value:g}")
+            return
+        if value == entry_value:
+            # Nothing to say. Enter-then-Enter with no arrows in between is
+            # a no-op, not a redundant gcode_script.
+            logging.info(f"Slider capture applied unchanged ({value:g}); nothing sent")
+            return
+        logging.info(f"Slider capture applied: {entry_value:g} -> {value:g}")
+        self._commit_range(widget)
+
+    def _commit_range(self, widget):
+        """Send a captured slider's value the way a mouse release would.
+
+        Every Gtk.Scale in this codebase -- fan, limits, led, pins,
+        retraction, pressure_advance, input_shaper, plus the generic
+        "scale" setting row in ks_includes/screen_panel.py -- wires its
+        transmit handler to "button-release-event" and to nothing else.
+        Rather than add a second signal at all eight construction sites
+        (and keep them in sync forever), raise the event those handlers
+        already listen for. One place, and mouse/touch behaviour is
+        untouched by construction.
+
+        Verified in isolation on this device's GTK 3.24.49 before wiring it
+        up, because a synthetic event with no GdkWindow is the obvious way
+        for this to explode: emitting "button-release-event" with
+        Gdk.Event.new(BUTTON_RELEASE) on a Gtk.Scale calls the connected
+        handler, hands it a real EventButton, and returns False. It is safe
+        here specifically because GTK 3.24's GtkRange has no
+        button_release_event class handler (it uses gesture controllers,
+        which a direct g_signal_emit does not run), and because none of the
+        eight handlers reads the event argument -- all of them take it and
+        immediately call widget.get_value() or read their adjustment.
+        """
+        try:
+            event = Gdk.Event.new(Gdk.EventType.BUTTON_RELEASE)
+            widget.emit("button-release-event", event)
+        except Exception:
+            logging.exception("Slider commit failed")
+
+    def _range_step(self, widget):
+        """How far one arrow press moves a captured slider.
+
+        The adjustment's own step_increment is unusable on a D-pad: it is 1
+        on Limits, where max_accel's range is ~1..4500, i.e. 4500 presses
+        end to end. Measured X autorepeat on this device is 25/s after a
+        660ms delay (xset q), so a step sized to ~100 presses per full
+        range means a held button crosses the whole slider in ~4.6s while a
+        single tap is still a fine-grained nudge. Snapped to a whole number
+        of step_increments so the displayed value keeps the panel's own
+        granularity (0.05 on Pressure Advance, 1 on Fan/Limits), and never
+        smaller than step_increment -- on short ranges (Pressure Advance
+        0..1) the panel's own increment is already the coarser of the two.
+        """
+        adj = widget.get_adjustment()
+        step = adj.get_step_increment() or 1
+        coarse = (adj.get_upper() - adj.get_lower()) / 100.0
+        if coarse > step:
+            step = max(1, round(coarse / step)) * step
+        return step
+
+    def _adjust_captured_range(self, keyval_name):
+        widget = self._captured_range
+        adj = widget.get_adjustment()
+        step = self._range_step(widget)
