+        before = adj.get_value()
+        value = min(max(before + delta, adj.get_lower()), adj.get_upper())
+        # Round to the precision the panel actually displays, so the value
+        # committed is the value on screen. Measured live on Pressure
+        # Advance 2026-08-01: arrowing back down to the bottom of the range
+        # showed "0.00" but transmitted
+        # "SET_PRESSURE_ADVANCE EXTRUDER=extruder ADVANCE=1.3877787807814457e-17",
+        # because repeated float addition of a 0.05 step does not land on
+        # zero. Harmless there, but "what is sent is not what is shown" is
+        # the exact shape of bug this whole slider fix exists to remove.
+        # Gtk.Scale.get_digits() is the panel's own declared granularity (0
+        # on Fan and Limits, 2 on Pressure Advance, 3 on Smooth time), so
+        # this can never round a slider coarser than it renders. set_value()
+        # re-clamps to the adjustment afterwards, so rounding outward at a
+        # non-round upper bound cannot escape the range.
+        digits = widget.get_digits()
+        if digits >= 0:
+            value = round(value, digits)
+        if value != before:
+            widget.set_value(value)
+        self._key_trace_branch = (
+            f"range-capture/adjust {before:g}->{widget.get_value():g} step={step:g}"
+        )
